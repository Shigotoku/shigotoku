<section id="contact" class="py-32 bg-gray-50">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div>
        <span class="inline-block rounded-full bg-blue-50 px-4 py-1.5 text-sm font-semibold text-blue-600 mb-4">お問い合わせ</span>
        <h2 class="text-4xl sm:text-5xl font-black tracking-tight text-gray-900 mb-6">お気軽に<br />ご相談ください</h2>
        <p class="text-gray-500 leading-relaxed mb-8">サービスに関するご質問・ご相談、取材・提携のご依頼など、お気軽にお問い合わせください。通常2〜3営業日以内にご返信いたします。</p>
        <div class="space-y-4">
          {[{ icon: '📧', label: 'メール', value: 'support@shigotoku.com' }, { icon: '🕐', label: '対応時間', value: '平日 10:00〜18:00' }, { icon: '📍', label: '所在地', value: '熊本県' }].map((item) => (
            <div class="flex items-center gap-3">
              <span class="text-xl">{item.icon}</span>
              <div>
                <p class="text-xs text-gray-400">{item.label}</p>
                <p class="text-sm font-medium text-gray-700">{item.value}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 sm:p-8">
        <div id="contact-success" class="hidden text-center py-12">
          <div class="w-16 h-16 rounded-full bg-green-50 flex items-center justify-center mx-auto mb-4">
            <svg class="h-8 w-8 text-green-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">送信が完了しました</h3>
          <p class="text-sm text-gray-500">お問い合わせありがとうございます。2〜3営業日以内にご返信いたします。</p>
          <button id="contact-reset" type="button" class="mt-6 text-sm text-blue-600 hover:underline">別のお問い合わせをする</button>
        </div>

        <form id="contact-form" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1.5">会社名</label>
            <input type="text" name="company" placeholder="株式会社〇〇" class="w-full rounded-lg border border-gray-200 bg-white px-4 py-3 text-base sm:py-2.5 sm:text-sm text-gray-900 placeholder-gray-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100 transition-colors" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1.5">お名前 <span class="text-red-500">*</span></label>
            <input type="text" name="name" required placeholder="山田 太郎" class="w-full rounded-lg border border-gray-200 bg-white px-4 py-3 text-base sm:py-2.5 sm:text-sm text-gray-900 placeholder-gray-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100 transition-colors" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1.5">メールアドレス <span class="text-red-500">*</span></label>
            <input type="email" name="email" required placeholder="you@example.com" class="w-full rounded-lg border border-gray-200 bg-white px-4 py-3 text-base sm:py-2.5 sm:text-sm text-gray-900 placeholder-gray-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100 transition-colors" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1.5">お問い合わせ内容 <span class="text-red-500">*</span></label>
            <textarea name="message" required rows={4} placeholder="お問い合わせ内容をご記入ください" class="w-full rounded-lg border border-gray-200 bg-white px-4 py-3 text-base sm:py-2.5 sm:text-sm text-gray-900 placeholder-gray-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100 transition-colors resize-none"></textarea>
          </div>
          <div class="flex items-start gap-2.5">
            <input type="checkbox" id="agree" name="agree" required class="mt-0.5 h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
            <label for="agree" class="text-xs text-gray-500 leading-relaxed"><a href="/privacy" class="text-blue-600 hover:underline">プライバシーポリシー</a>に同意する</label>
          </div>
          <p id="contact-error" class="hidden text-sm text-red-600 bg-red-50 rounded-lg px-4 py-2.5">送信に失敗しました。時間をおいて再度お試しください。</p>
          <button type="submit" id="contact-submit" class="w-full rounded-lg bg-blue-600 px-6 py-3 text-sm font-semibold text-white hover:bg-blue-700 transition-colors disabled:opacity-60 disabled:cursor-not-allowed shadow-sm">送信する</button>
          <p class="text-xs text-gray-400 text-center"><span class="text-red-500">*</span> は必須項目です</p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('contact-success');
  const error = document.getElementById('contact-error');
  const submit = document.getElementById('contact-submit');
  const reset = document.getElementById('contact-reset');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    error?.classList.add('hidden');
    submit?.setAttribute('disabled', 'true');
    if (submit) submit.textContent = '送信中...';

    const data = new FormData(form);
    try {
      const res = await fetch('https://formspree.io/f/REPLACE_WITH_YOUR_ID', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data,
      });
      if (res.ok) {
        form.classList.add('hidden');
        success?.classList.remove('hidden');
        form.reset();
      } else {
        error?.classList.remove('hidden');
      }
    } catch {
      error?.classList.remove('hidden');
    } finally {
      submit?.removeAttribute('disabled');
      if (submit) submit.textContent = '送信する';
    }
  });

  reset?.addEventListener('click', () => {
    success?.classList.add('hidden');
    form?.classList.remove('hidden');
  });
</script>
