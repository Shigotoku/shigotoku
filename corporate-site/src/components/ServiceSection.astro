---
import { RUNWITH_LP, BUZZIT_LP, CLIPIT_LP, runwithLoginUrl, buzzitLoginUrl, clipitLoginUrl } from '../lib/urls';
import { productImages } from '../lib/assets';

const products = [
  {
    badge: 'FLAGSHIP PRODUCT',
    badgeClass: 'bg-blue-50 text-blue-600',
    name: 'ランウィズ',
    en: 'Runwith',
    description: '創業から資金調達まで。30以上のツールを搭載したオールインワンSaaS。',
    highlight: '30+ ツール搭載',
    highlightSub: '創業前 〜 IPO・M&A',
    tags: ['無料プランあり', 'AI搭載', '医療モード'],
    siteUrl: RUNWITH_LP,
    demoUrl: runwithLoginUrl(),
    accent: {
      ring: 'from-blue-600 to-violet-600',
      shadow: 'shadow-blue-100',
      btn: 'bg-blue-600 hover:bg-blue-700',
      demo: 'border-blue-200 bg-blue-50 text-blue-700 hover:bg-blue-100',
      visual: 'from-blue-50 to-violet-50 border-blue-100',
      tag: 'border-blue-100 text-blue-700',
      logoRing: 'ring-blue-100',
    },
    logo: { type: 'img' as const, src: productImages.runwith, alt: 'ランウィズ' },
  },
  {
    badge: 'SNS × 売上',
    badgeClass: 'bg-indigo-50 text-indigo-600',
    name: 'バジット',
    en: 'BuzzIt',
    description: 'BtoC店舗向けSNS運用・売上トラッキングOS。毎朝5分のルーティンで回せます。',
    highlight: 'Instagram × LINE',
    highlightSub: '美容サロン・店舗向け',
    tags: ['無料診断あり', 'AI台本', '売上管理'],
    siteUrl: BUZZIT_LP,
    demoUrl: buzzitLoginUrl(),
    accent: {
      ring: 'from-indigo-600 to-sky-500',
      shadow: 'shadow-indigo-100',
      btn: 'bg-indigo-600 hover:bg-indigo-700',
      demo: 'border-indigo-200 bg-indigo-50 text-indigo-700 hover:bg-indigo-100',
      visual: 'from-indigo-50 to-sky-50 border-indigo-100',
      tag: 'border-indigo-100 text-indigo-700',
      logoRing: 'ring-indigo-100',
    },
    logo: { type: 'letter' as const, letter: 'B', bg: 'bg-indigo-600' },
  },
  {
    badge: '教える手間をなくす',
    badgeClass: 'bg-orange-50 text-orange-600',
    name: 'クリッピット',
    en: 'ClipIt',
    description: '操作するだけでスクショ付き業務マニュアルが完成。小さな会社のための教え方SaaS。',
    highlight: '記録するだけマニュアル',
    highlightSub: 'クリニック・中小企業向け',
    tags: ['無料プランあり', 'AI手順生成', 'QR・A4'],
    siteUrl: CLIPIT_LP,
    demoUrl: clipitLoginUrl(),
    accent: {
      ring: 'from-orange-500 to-amber-400',
      shadow: 'shadow-orange-100',
      btn: 'bg-orange-500 hover:bg-orange-600',
      demo: 'border-orange-200 bg-orange-50 text-orange-700 hover:bg-orange-100',
      visual: 'from-orange-50 to-amber-50 border-orange-100',
      tag: 'border-orange-100 text-orange-700',
      logoRing: 'ring-orange-100',
    },
    logo: { type: 'img' as const, src: `${productImages.clipit}?v=5`, alt: 'クリッピット' },
  },
];

const features = [
  { color: 'bg-blue-50', iconColor: 'text-blue-600', title: 'ジャーニーマップ', description: '創業前〜EXITまでの全タスクを可視化。進捗バーで次のアクションが一目でわかります。', demoUrl: runwithLoginUrl() },
  { color: 'bg-amber-50', iconColor: 'text-amber-600', title: '補助金・助成金マッチング', description: 'AIが会社情報から最適な補助金を自動マッチング。締切管理・申請支援まで一括対応。', demoUrl: runwithLoginUrl() },
  { color: 'bg-emerald-50', iconColor: 'text-emerald-600', title: '事業シミュレーション', description: '60ヶ月収支予測・バリュエーション算定・感度分析。投資家への説明データを瞬時に生成。', demoUrl: runwithLoginUrl() },
  { color: 'bg-violet-50', iconColor: 'text-violet-600', title: 'AI壁打ち支援', description: '入力内容からプロンプトを自動生成。ビジネスモデル、定款、ピッチ資料をAIと一緒に作成。', demoUrl: runwithLoginUrl() },
];
---

<section id="service" class="py-32 bg-gray-50">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="text-center mb-16 headline-fit-wrap">
      <span class="inline-block rounded-full bg-blue-50 px-4 py-1.5 text-sm font-semibold text-blue-600 mb-4">Service</span>
      <h2 class="text-4xl sm:text-5xl font-black tracking-tight text-gray-900" data-headline-fit>プロダクト</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-gray-500">スタートアップに必要なすべてを、ひとつのプラットフォームに。</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-6">
      {products.map((product) => (
        <article class={`rounded-2xl bg-gradient-to-br ${product.accent.ring} p-px shadow-lg ${product.accent.shadow} h-full`}>
          <div class="flex h-full flex-col rounded-[calc(1rem-1px)] bg-white p-5 sm:p-6">
            <div class={`mb-4 flex min-h-[140px] flex-col items-center justify-center rounded-xl border bg-gradient-to-br p-4 text-center ${product.accent.visual}`}>
              {product.logo.type === 'img' ? (
                <div class={`mb-2 flex h-14 w-14 items-center justify-center rounded-xl bg-white p-1.5 shadow-sm ring-1 ${product.accent.logoRing}`}>
                  <img src={product.logo.src} alt={product.logo.alt} class="h-full w-full object-contain" />
                </div>
              ) : (
                <div class={`mb-2 flex h-14 w-14 items-center justify-center rounded-xl ${product.logo.bg} text-2xl font-black text-white shadow-sm`}>
                  {product.logo.letter}
                </div>
              )}
              <p class="text-base font-black text-gray-900 leading-snug">{product.highlight}</p>
              <p class="mt-0.5 text-xs text-gray-500">{product.highlightSub}</p>
            </div>

            <span class={`mb-2 inline-block w-fit rounded-full px-2.5 py-0.5 text-[11px] font-bold ${product.badgeClass}`}>{product.badge}</span>
            <h3 class="text-xl font-black text-gray-900">
              {product.name} <span class="text-sm font-semibold text-gray-400">({product.en})</span>
            </h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-gray-500">{product.description}</p>

            <div class="mt-3 flex flex-wrap gap-1.5">
              {product.tags.map((tag) => (
                <span class={`rounded-full border bg-white px-2 py-0.5 text-[11px] font-medium shadow-sm ${product.accent.tag}`}>{tag}</span>
              ))}
            </div>

            <div class="mt-5 flex flex-col gap-2">
              <a href={product.siteUrl} class={`group inline-flex items-center justify-center gap-1.5 rounded-lg px-4 py-2.5 text-sm font-semibold text-white transition-colors shadow-sm ${product.accent.btn}`}>
                サービスサイトへ
                <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
              </a>
              <a href={product.demoUrl} class={`group inline-flex items-center justify-center gap-1.5 rounded-lg border px-4 py-2.5 text-sm font-semibold transition-colors ${product.accent.demo}`}>
                デモを試す
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 010 1.972l-11.54 6.347a1.125 1.125 0 01-1.667-.986V5.653z" /></svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-12">
      {features.map((feature) => (
        <div class="group rounded-2xl bg-white border border-gray-100 p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col">
          <div class={`inline-flex items-center justify-center w-11 h-11 rounded-xl ${feature.color} ${feature.iconColor} mb-4 text-lg font-bold`}>◆</div>
          <h4 class="text-lg font-bold text-gray-900 mb-2">{feature.title}</h4>
          <p class="text-gray-500 text-sm leading-relaxed flex-1">{feature.description}</p>
          <div class="mt-4 pt-4 border-t border-gray-50">
            <a href={feature.demoUrl} class="inline-flex items-center gap-1.5 text-sm font-semibold text-blue-600 hover:text-blue-700 transition-colors">
              デモを見る
              <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
