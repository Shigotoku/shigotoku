---
import { missionCards } from '../data/content';
---

<section id="mission" class="py-32 bg-white">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="inline-block rounded-full bg-blue-50 px-4 py-1.5 text-sm font-semibold text-blue-600 mb-4">Mission</span>
      <h2 class="text-4xl sm:text-5xl font-black tracking-tight text-gray-900">
        すべての挑戦者に、<br />
        <span class="bg-gradient-to-r from-blue-600 to-violet-600 bg-clip-text text-transparent">最高のスタートを。</span>
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-500 leading-relaxed">
        スタートアップは社会を変える力を持っています。しかし多くの起業家が「次に何をすべきか」に迷い、貴重な時間を失っています。私たちはその障壁を取り除き、起業家が本来の挑戦に集中できる世界をつくります。
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {missionCards.map((item) => (
        <div class="rounded-2xl border border-gray-100 bg-white p-8 shadow-sm hover:shadow-md transition-shadow text-center">
          <div class="flex items-center justify-center mb-5 h-28">
            <img src={item.img} alt={item.title} class="h-full w-auto object-contain" />
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">{item.title}</h3>
          <p class="text-gray-500 leading-relaxed text-sm">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
