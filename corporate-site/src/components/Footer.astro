---
import { RUNWITH_LP, BUZZIT_LP, CLIPIT_LP, runwithPath, runwithLoginUrl } from '../lib/urls';
import { brandLogo } from '../lib/assets';

const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-white">
  <div class="mx-auto max-w-7xl px-6 lg:px-8 pt-16 pb-8">
    <div class="mb-14 rounded-2xl border border-white/10 bg-white/5 px-8 py-10 sm:px-10">
      <a href="/" class="inline-flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 group">
        <img
          src={brandLogo}
          alt="シゴトク"
          class="h-16 sm:h-20 w-auto object-contain transition-opacity group-hover:opacity-90"
        />
        <div>
          <p class="text-3xl sm:text-4xl font-black tracking-tight text-white">シゴトク</p>
          <p class="mt-1 text-sm sm:text-base text-gray-400">株式会社シゴトク</p>
        </div>
      </a>
      <p class="mt-6 max-w-2xl text-sm sm:text-base text-gray-400 leading-relaxed">
        テクノロジーの力でスタートアップの挑戦を加速する。創業から EXIT までを一気通貫でサポートします。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 mb-12">
      <div>
        <h3 class="text-sm font-semibold text-gray-200 mb-4">サービス</h3>
        <ul class="space-y-2.5">
          <li><a href={RUNWITH_LP} class="text-sm text-gray-400 hover:text-white transition-colors">ランウィズ</a></li>
          <li><a href={BUZZIT_LP} class="text-sm text-gray-400 hover:text-white transition-colors">バジット (BuzzIt)</a></li>
          <li><a href={CLIPIT_LP} class="text-sm text-gray-400 hover:text-white transition-colors">クリッピット (ClipIt)</a></li>
          <li><a href={runwithLoginUrl()} class="text-sm text-gray-400 hover:text-white transition-colors">ランウィズ ログイン</a></li>
          <li><a href={runwithPath('/pricing')} class="text-sm text-gray-400 hover:text-white transition-colors">ランウィズ 料金</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-gray-200 mb-4">会社情報</h3>
        <ul class="space-y-2.5">
          <li><a href="/#mission" class="text-sm text-gray-400 hover:text-white transition-colors">ミッション</a></li>
          <li><a href="/#service" class="text-sm text-gray-400 hover:text-white transition-colors">サービス</a></li>
          <li><a href="/news/" class="text-sm text-gray-400 hover:text-white transition-colors">お知らせ</a></li>
          <li><a href="/#company" class="text-sm text-gray-400 hover:text-white transition-colors">会社概要</a></li>
          <li><a href="/#contact" class="text-sm text-gray-400 hover:text-white transition-colors">お問い合わせ</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-gray-200 mb-4">法的情報・ポリシー</h3>
        <ul class="space-y-2.5">
          <li><a href="/privacy" class="text-sm text-gray-400 hover:text-white transition-colors">プライバシーポリシー</a></li>
          <li><a href="/terms" class="text-sm text-gray-400 hover:text-white transition-colors">利用規約</a></li>
          <li><a href="/tokushoho" class="text-sm text-gray-400 hover:text-white transition-colors">特定商取引法に基づく表記</a></li>
          <li><a href="/security" class="text-sm text-gray-400 hover:text-white transition-colors">情報セキュリティ方針</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-xs text-gray-500">&copy; {currentYear} 株式会社シゴトク. All rights reserved.</p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href="/privacy" class="text-xs text-gray-500 hover:text-gray-300 transition-colors">プライバシーポリシー</a>
          <a href="/terms" class="text-xs text-gray-500 hover:text-gray-300 transition-colors">利用規約</a>
          <a href="/tokushoho" class="text-xs text-gray-500 hover:text-gray-300 transition-colors">特定商取引法に基づく表記</a>
          <a href="/security" class="text-xs text-gray-500 hover:text-gray-300 transition-colors">情報セキュリティ方針</a>
        </div>
      </div>
    </div>
  </div>
</footer>
