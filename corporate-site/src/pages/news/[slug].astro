---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { newsCategoryStyles, formatNewsDate } from '../../lib/news';

export async function getStaticPaths() {
  const posts = await getCollection('news', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | お知らせ | 株式会社シゴトク`} description={post.data.title}>
  <main class="py-24 bg-gray-50 min-h-[60vh]">
    <article class="mx-auto max-w-3xl px-6 lg:px-8">
      <a href="/news/" class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-blue-600 transition-colors mb-8">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
        お知らせ一覧
      </a>
      <div class="mb-6 flex flex-wrap items-center gap-3">
        <time datetime={post.data.pubDate.toISOString()} class="text-sm text-gray-400 font-mono">{formatNewsDate(post.data.pubDate)}</time>
        <span class={`inline-flex rounded-full px-3 py-0.5 text-xs font-semibold ${newsCategoryStyles[post.data.category] ?? 'bg-gray-100 text-gray-700'}`}>{post.data.category}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-gray-900 mb-8">{post.data.title}</h1>
      <div class="prose prose-gray max-w-none bg-white rounded-2xl border border-gray-100 shadow-sm p-8 sm:p-10">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<style>
  .prose :global(p) {
    margin-bottom: 1rem;
    line-height: 1.75;
    color: #374151;
  }
  .prose :global(a) {
    color: #2563eb;
    text-decoration: underline;
  }
  .prose :global(a:hover) {
    color: #1d4ed8;
  }
</style>
