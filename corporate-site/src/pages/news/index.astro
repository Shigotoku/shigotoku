---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { newsCategoryStyles, formatNewsDate } from '../../lib/news';

const allNews = await getCollection('news', ({ data }) => !data.draft);
const news = allNews.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="お知らせ | 株式会社シゴトク" description="株式会社シゴトクからのお知らせ一覧です。">
  <main class="py-24 bg-gray-50 min-h-[60vh]">
    <div class="mx-auto max-w-4xl px-6 lg:px-8">
      <a href="/#news" class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-blue-600 transition-colors mb-8">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
        トップへ戻る
      </a>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-gray-900 mb-10">お知らせ</h1>
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm divide-y divide-gray-100 overflow-hidden">
        {news.map((item) => (
          <article class="group">
            <a href={`/news/${item.id}/`} class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 p-6 hover:bg-blue-50/30 transition-colors">
              <time datetime={item.data.pubDate.toISOString()} class="text-sm text-gray-400 font-mono shrink-0">{formatNewsDate(item.data.pubDate)}</time>
              <span class={`inline-flex self-start rounded-full px-3 py-0.5 text-xs font-semibold shrink-0 ${newsCategoryStyles[item.data.category] ?? 'bg-gray-100 text-gray-700'}`}>{item.data.category}</span>
              <h2 class="text-sm sm:text-base font-medium text-gray-700 group-hover:text-blue-600 transition-colors flex-1">{item.data.title}</h2>
            </a>
          </article>
        ))}
      </div>
    </div>
  </main>
</Layout>
