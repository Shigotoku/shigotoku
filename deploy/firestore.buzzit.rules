rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStoreMember(storeId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{subcollection=**}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /stores/{storeId} {
      allow read: if isStoreMember(storeId);
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)).data.role == 'owner';

      match /members/{memberId} {
        allow read: if isStoreMember(storeId);
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)).data.role in ['owner', 'manager'];
      }

      match /invitations/{invitationId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)).data.role in ['owner', 'manager'];
      }
    }

    match /buzzit_invitation_tokens/{token} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /tracking/{token} {
      allow read, write: if false;
    }

    match /oauthStates/{state} {
      allow read, write: if false;
    }

    match /enterpriseInquiries/{id} {
      allow read, write: if false;
    }
  }
}
