rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStoreMember(storeId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid));
    }

    // 書き込みはすべてサーバー(Admin SDK)経由。クライアントから plan・利用回数などを書き換えられないようにする
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
      match /{subcollection=**}/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /stores/{storeId} {
      allow read: if isStoreMember(storeId);
      allow write: if false;

      match /members/{memberId} {
        allow read: if isStoreMember(storeId);
        allow write: if false;
      }

      match /invitations/{invitationId} {
        allow read, write: if false;
      }
    }

    match /buzzit_invitation_tokens/{token} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /tracking/{token} {
      allow read, write: if false;
    }

    match /oauthStates/{state} {
      allow read, write: if false;
    }

    match /enterpriseInquiries/{id} {
      allow read, write: if false;
    }
  }
}
