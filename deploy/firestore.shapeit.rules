rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isShapeItAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'meditoku.jp@gmail.com',
          'admin@shigotoku.com'
        ];
    }

    function isShapeItMember(orgId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/shapeit_organizations/$(orgId)/members/$(request.auth.uid));
    }

    function canAccessOrgData(orgId) {
      return isShapeItMember(orgId)
        || isShapeItAdmin();
    }

    function memberDoc(orgId) {
      return get(/databases/$(database)/documents/shapeit_organizations/$(orgId)/members/$(request.auth.uid));
    }

    function isOrgAdmin(orgId) {
      return isShapeItMember(orgId)
        && memberDoc(orgId).data.role in ['admin', 'owner'];
    }

    match /shapeit_organizations/{orgId} {
      allow read: if request.auth != null && (isShapeItMember(orgId) || isShapeItAdmin());
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && (
          !exists(/databases/$(database)/documents/shapeit_users/$(request.auth.uid))
          || !('organizationId' in get(/databases/$(database)/documents/shapeit_users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/shapeit_users/$(request.auth.uid)).data.organizationId == ''
        );
      allow update: if isOrgAdmin(orgId) || isShapeItAdmin();
      allow delete: if isShapeItAdmin();

      match /invites/{inviteId} {
        allow read: if request.auth != null && (isShapeItMember(orgId) || isShapeItAdmin());
        allow create, update, delete: if isOrgAdmin(orgId) || isShapeItAdmin();
      }

      match /members/{memberId} {
        allow read: if request.auth != null && (isShapeItMember(orgId) || isShapeItAdmin());
        allow create: if request.auth != null && (
          isOrgAdmin(orgId)
          || isShapeItAdmin()
          || (request.auth.uid == memberId
              && request.resource.data.role == 'owner'
              && get(/databases/$(database)/documents/shapeit_organizations/$(orgId)).data.ownerUid == request.auth.uid
              && !exists(/databases/$(database)/documents/shapeit_organizations/$(orgId)/members/$(memberId)))
        );
        allow update: if request.auth != null && (
          request.auth.uid == memberId
          || isOrgAdmin(orgId)
          || isShapeItAdmin()
        );
        allow delete: if isOrgAdmin(orgId) || isShapeItAdmin();
      }
    }

    match /shapeit_users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isShapeItAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if isShapeItAdmin();
    }

    match /shapeit_invitations/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if request.auth != null;
    }

    match /shapeit_feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && canAccessOrgData(request.resource.data.organizationId);
      allow read, update, delete: if request.auth != null
        && canAccessOrgData(resource.data.organizationId);
    }

    match /shapeit_issues/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && canAccessOrgData(request.resource.data.organizationId);
      allow read, update, delete: if request.auth != null
        && canAccessOrgData(resource.data.organizationId);
    }

    match /shapeit_comments/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /shapeit_notifications/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /shapeit_changelog/{id} {
      allow create: if request.auth != null
        && canAccessOrgData(request.resource.data.organizationId);
      allow update, delete: if request.auth != null
        && canAccessOrgData(resource.data.organizationId);
      allow read: if resource.data.visibility == 'public'
        || (request.auth != null && canAccessOrgData(resource.data.organizationId));
    }

    match /shapeit_fix_pack_meta/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && canAccessOrgData(request.resource.data.organizationId);
      allow read, update, delete: if request.auth != null
        && canAccessOrgData(resource.data.organizationId);
    }

    match /shapeit_project_keys/{id} {
      allow read: if false;
      allow write: if isShapeItAdmin();
    }

    match /shapeit_weekly_digests/{id} {
      allow read: if request.auth != null
        && canAccessOrgData(resource.data.organizationId);
      allow write: if false;
    }
  }
}
