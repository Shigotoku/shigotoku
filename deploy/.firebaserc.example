{
  "projects": {
    "default": "YOUR_GCP_PROJECT_ID",
    "buzzit": "shigotoku-prod",
    "runwith": "shigotoku-runwith-prod"
  },
  "targets": {
    "shigotoku-prod": {
      "hosting": {
        "shigotoku-web": ["shigotoku-web"],
        "buzzit-app": ["shigotoku-buzzit-app"]
      }
    },
    "shigotoku-runwith-prod": {
      "hosting": {
        "runwith-app": ["shigotoku-runwith-app"]
      }
    }
  }
}
