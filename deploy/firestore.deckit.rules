rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function membershipId(orgId) {
      return orgId + '_' + request.auth.uid;
    }

    function isMember(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/deckit_memberships/$(membershipId(orgId)));
    }

    match /deckit_users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /deckit_organizations/{orgId} {
      allow read: if isMember(orgId);
      allow create: if isSignedIn()
        && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if isMember(orgId);
    }

    match /deckit_memberships/{membershipId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    match /deckit_projects/{projectId} {
      allow read: if isSignedIn() && isMember(resource.data.organizationId);
      allow create: if isSignedIn()
        && isMember(request.resource.data.organizationId);
      allow update, delete: if isSignedIn()
        && isMember(resource.data.organizationId);
    }

    match /deckit_styles/{styleId} {
      allow read: if isSignedIn() && isMember(resource.data.organizationId);
      allow create: if isSignedIn()
        && isMember(request.resource.data.organizationId);
      allow update, delete: if isSignedIn()
        && isMember(resource.data.organizationId);
    }

    match /deckit_references/{refId} {
      allow read: if isSignedIn() && isMember(resource.data.organizationId);
      allow create: if isSignedIn()
        && isMember(request.resource.data.organizationId);
      allow update, delete: if isSignedIn()
        && isMember(resource.data.organizationId);
    }

    match /deckit_google_connections/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /deckit_idempotency/{key} {
      allow read, write: if false;
    }
  }
}
