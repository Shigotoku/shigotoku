# 招待メール（Resend 推奨 — ClipIt と同じ API キーを共有可能）
RESEND_API_KEY=
SHAPEIT_NOTIFY_FROM=ShapeIt <notify@shapeit.shigotoku.com>

# 代替: SMTP（Resend 未設定時のみ使用）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=ShapeIt <notify@shapeit.shigotoku.com>

# アプリ URL（招待リンクのベース。省略時は本番 URL）
# SHAPEIT_APP_URL=https://app.shapeit.shigotoku.com
