# ShapeIt ローカル開発用（shapeit/app/.env にコピー）
# Firebase Console → shigotoku-shapeit-prod → プロジェクトの設定 → Web アプリ

VITE_LANDING_URL=http://localhost:4321/shapeit
VITE_API_URL=http://localhost:5177/api

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=shigotoku-shapeit-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=shigotoku-shapeit-prod
VITE_FIREBASE_STORAGE_BUCKET=shigotoku-shapeit-prod.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
