{
  "manifest_version": 3,
  "name": "ShapeIt - 気づきを投稿",
  "version": "0.3.0",
  "description": "開いている画面のスクショ（全画面・範囲選択）に書き込み、URL 付きで ShapeIt に改善報告を送ります。",
  "permissions": ["activeTab", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://app.shapeit.shigotoku.com/*",
    "https://shigotoku-shapeit-app.web.app/*",
    "https://asia-northeast1-shigotoku-shapeit-prod.cloudfunctions.net/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "ShapeIt に報告",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "quick-report": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "画面をキャプチャして ShapeIt 報告画面を開く"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.shapeit.shigotoku.com/*",
        "https://shigotoku-shapeit-app.web.app/*",
        "http://localhost:5178/*",
        "http://127.0.0.1:5178/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
