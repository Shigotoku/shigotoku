---
import '../styles/global.css';
import { appPath, sitePath, shapeitIconPath } from '../lib/urls';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'ShapeIt（シェイプイット）— みんなで気づき、みんなで良くする。AI Product Feedback OS。',
} = Astro.props;

const loginUrl = appPath('/login');
const homeUrl = import.meta.env.BASE_URL;
const howUrl = `${homeUrl}#how-it-works`;
const featuresUrl = `${homeUrl}#features`;
const pricingAnchorUrl = `${homeUrl}#pricing`;
const faqUrl = `${homeUrl}#faq`;
const pricingUrl = sitePath('pricing');
const securityUrl = sitePath('security');
const privacyUrl = sitePath('privacy');
const featuresPageUrl = sitePath('features');
---

<!doctype html>
<html lang="ja" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={shapeitIconPath} />
    <link rel="apple-touch-icon" href={shapeitIconPath} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen antialiased">
    <header class="sticky top-0 z-50 border-b border-ink/10 bg-paper/90 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
        <a href={homeUrl} class="flex items-center gap-2.5 transition-opacity hover:opacity-80">
          <span class="shapeit-icon-frame shapeit-icon-frame--header">
            <img src={shapeitIconPath} alt="ShapeIt" class="shapeit-brand-icon" width="36" height="36" />
          </span>
          <span class="font-display text-lg font-semibold tracking-tight text-ink">ShapeIt</span>
        </a>
        <nav class="hidden items-center gap-6 md:flex">
          <a href={howUrl} class="text-sm font-medium text-ink/55 hover:text-ink">使い方</a>
          <a href={featuresUrl} class="text-sm font-medium text-ink/55 hover:text-ink">機能</a>
          <a href={pricingAnchorUrl} class="text-sm font-medium text-ink/55 hover:text-ink">料金</a>
          <a href={faqUrl} class="text-sm font-medium text-ink/55 hover:text-ink">FAQ</a>
          <a href={loginUrl} class="text-sm font-medium text-ink/55 hover:text-ink">ログイン</a>
          <a href={loginUrl} class="rounded-lg bg-mint px-4 py-2 text-sm font-semibold text-white hover:bg-mint-bright">無料で始める</a>
        </nav>
        <button
          id="menu-toggle"
          type="button"
          class="rounded-lg p-2 text-ink/70 transition-colors hover:bg-ink/5 md:hidden"
          aria-label="メニューを開く"
        >
          <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
          <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <div id="mobile-menu" class="hidden border-t border-ink/10 bg-paper px-4 pb-4 pt-2 md:hidden">
        <a href={howUrl} class="block min-h-[44px] rounded-lg px-3 py-3 text-sm font-medium text-ink/70 hover:bg-ink/5">使い方</a>
        <a href={featuresUrl} class="block min-h-[44px] rounded-lg px-3 py-3 text-sm font-medium text-ink/70 hover:bg-ink/5">機能</a>
        <a href={pricingAnchorUrl} class="block min-h-[44px] rounded-lg px-3 py-3 text-sm font-medium text-ink/70 hover:bg-ink/5">料金</a>
        <a href={faqUrl} class="block min-h-[44px] rounded-lg px-3 py-3 text-sm font-medium text-ink/70 hover:bg-ink/5">FAQ</a>
        <a href={loginUrl} class="block min-h-[44px] rounded-lg px-3 py-3 text-sm font-medium text-ink/70 hover:bg-ink/5">ログイン</a>
        <a href={loginUrl} class="mt-2 block min-h-[44px] rounded-xl bg-mint px-4 py-3.5 text-center text-sm font-semibold text-white">無料で始める</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="border-t border-ink/10 bg-ink text-paper">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:flex-row sm:items-start sm:justify-between sm:px-6">
        <div class="flex items-start gap-3">
          <span class="shapeit-icon-frame shapeit-icon-frame--footer">
            <img src={shapeitIconPath} alt="" class="shapeit-brand-icon" width="40" height="40" />
          </span>
          <div>
            <p class="font-display text-lg font-semibold">ShapeIt</p>
            <p class="mt-1 text-sm text-paper/55">みんなで気づき、みんなで良くする。</p>
          </div>
        </div>
        <div class="flex flex-wrap gap-4 text-sm text-paper/65">
          <a href={featuresPageUrl} class="hover:text-paper">機能詳細</a>
          <a href={pricingUrl} class="hover:text-paper">料金</a>
          <a href={securityUrl} class="hover:text-paper">セキュリティ</a>
          <a href={privacyUrl} class="hover:text-paper">Privacy</a>
          <a href="https://shigotoku.com/" class="hover:text-paper">シゴトク</a>
        </div>
      </div>
    </footer>
    <script>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');
      toggle?.addEventListener('click', () => {
        const open = menu?.classList.toggle('hidden') === false;
        iconOpen?.classList.toggle('hidden', open);
        iconClose?.classList.toggle('hidden', !open);
        toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
      });
    </script>
  </body>
</html>
