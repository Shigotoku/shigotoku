---
const stats = [
  { value: '10秒', label: '気づきの投稿（中央値）' },
  { value: 'AI整理', label: '分類・重複・優先度' },
  { value: '全員投稿', label: '席課金で増やさない' },
  { value: 'Closed Loop', label: '直ったら投稿者へ確認' },
];
---

<section class="border-y border-ink/10 bg-white py-8 sm:py-10">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-6 px-4 sm:grid-cols-4 sm:gap-8 sm:px-6">
    {stats.map((s) => (
      <div class="min-w-0 text-center">
        <p class="font-display text-xl font-bold text-mint sm:text-2xl lg:text-3xl" data-jp-wrap>{s.value}</p>
        <p class="mt-1 text-xs text-ink/50 sm:text-sm" data-jp-wrap>{s.label}</p>
      </div>
    ))}
  </div>
</section>
