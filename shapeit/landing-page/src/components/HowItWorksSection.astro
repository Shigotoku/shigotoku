---
const steps = [
  {
    num: '1',
    title: '気づいたら、すぐ投稿',
    body: '一言＋スクショでOK。URLや環境は自動取得',
  },
  {
    num: '2',
    title: 'AIが整理・Inboxへ',
    body: '分類・重複候補・優先度を生成。管理者は判断だけ',
  },
  {
    num: '3',
    title: '直して、みんなで確認',
    body: 'Boardで進め、Done後に投稿者へClosed Loop',
  },
];
---

<section id="how-it-works" class="shapeit-section bg-white">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-mint sm:text-sm">How it works</p>
      <h2 class="shapeit-h2 font-display mt-3 font-bold tracking-tight text-ink" data-jp-heading>
        使い方は、3ステップ
      </h2>
      <p class="shapeit-lead mt-3 text-ink/65 sm:mt-4" data-jp-wrap>
        投稿 → 整理 → 確認。報告者にも管理者にも、余計な作業を増やしません。
      </p>
    </div>
    <ol class="shapeit-grid-safe mt-8 grid gap-3 sm:mt-10 sm:grid-cols-3 sm:gap-5">
      {steps.map((s) => (
        <li class="flex h-full flex-col rounded-2xl border border-ink/10 bg-paper px-4 py-5 sm:px-6 sm:py-6">
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-mint text-base font-bold text-white sm:h-10 sm:w-10 sm:text-lg">
            {s.num}
          </span>
          <h3 class="shapeit-h3 font-display mt-3 font-bold text-ink sm:mt-4" data-jp-heading>{s.title}</h3>
          <p class="shapeit-body mt-2 flex-1 text-ink/60" data-jp-wrap>{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
