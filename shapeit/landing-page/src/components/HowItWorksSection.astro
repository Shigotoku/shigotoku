---
const steps = [
  {
    num: '1',
    title: '気づいたら、すぐ投稿',
    body: '一言＋スクショでOK。URLや環境は自動取得',
  },
  {
    num: '2',
    title: 'AIが整理・Inboxへ',
    body: '分類・重複候補・優先度を生成。管理者は判断だけ',
  },
  {
    num: '3',
    title: '直して、みんなで確認',
    body: 'Boardで進め、Done後に投稿者へClosed Loop',
  },
];
---

<section id="how-it-works" class="bg-white py-12 sm:py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-mint">How it works</p>
      <h2 class="font-display mt-3 text-2xl font-bold tracking-tight text-ink sm:text-3xl" data-jp-heading>
        使い方は、3ステップ
      </h2>
      <p class="mt-3 text-base text-ink/65 sm:mt-4" data-jp-wrap>
        投稿 → 整理 → 確認。報告者にも管理者にも、余計な作業を増やしません。
      </p>
    </div>
    <ol class="mt-10 grid gap-4 sm:grid-cols-3 sm:gap-5">
      {steps.map((s) => (
        <li class="flex h-full flex-col rounded-2xl border border-ink/10 bg-paper px-5 py-6 sm:px-6">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-mint text-lg font-bold text-white">
            {s.num}
          </span>
          <h3 class="font-display mt-4 text-base font-bold text-ink sm:text-lg" data-jp-heading>{s.title}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/60" data-jp-wrap>{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
