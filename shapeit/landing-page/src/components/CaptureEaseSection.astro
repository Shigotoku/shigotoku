---
import { assetPath } from '../lib/urls';

const captureUrl = assetPath('capture-ease.png');

const points = [
  { title: '必須は「内容」だけ', body: 'カテゴリ・優先度・担当は入力不要。AIが後から付けます。' },
  { title: 'PCは拡張、携帯はPWA', body: 'PCはChrome拡張でスクショとURLを自動取得。携帯はホーム画面追加＋アルバム／共有が本命です。' },
  { title: 'スクショ → 話す → 送信', body: '手が離せないときは端末の音声認識で話すだけ。キーボードのマイクにもフォールバックします。' },
  { title: '機微情報も前提設計', body: 'スクショに個人情報が写る前提で、マスク・権限・監査を用意。' },
];
---

<section id="capture" class="shapeit-section--lg border-y border-ink/10 bg-paper">
  <div class="mx-auto grid max-w-6xl items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16">
    <div class="order-2 lg:order-1">
      <p class="text-xs font-semibold uppercase tracking-widest text-mint sm:text-sm">Effortless capture</p>
      <h2 class="shapeit-h2 font-display mt-3 font-bold tracking-tight text-ink" data-jp-heading>
        エラーも使いにくさも、<br class="hidden sm:block" />できるだけ手間をかけずに。
      </h2>
      <p class="shapeit-lead mt-3 text-ink/65 sm:mt-4" data-jp-wrap>
        「あとで書こう」は大抵、書かれません。ShapeItは気づいた<strong class="font-semibold text-ink">その場で10秒</strong>残せるように設計しています。
      </p>
      <ul class="mt-6 space-y-4 sm:mt-8 sm:space-y-5">
        {points.map((p) => (
          <li class="flex gap-3">
            <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-mint" aria-hidden="true"></span>
            <div class="min-w-0">
              <p class="font-semibold text-ink" data-jp-heading>{p.title}</p>
              <p class="shapeit-body mt-1 text-ink/60" data-jp-wrap>{p.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="order-1 shapeit-capture-visual relative lg:order-2">
      <div class="overflow-hidden rounded-xl border border-ink/10 shadow-xl shadow-ink/10 sm:rounded-2xl">
        <img
          src={captureUrl}
          alt="ノートPCで画面の気づきを素早く記録する様子"
          class="shapeit-capture-img aspect-[16/10] w-full object-cover sm:aspect-[16/11]"
          width={1280}
          height={880}
          loading="lazy"
          decoding="async"
        />
      </div>
      <p class="pointer-events-none absolute -bottom-2 left-3 right-3 rounded-xl border border-mint/30 bg-ink px-3 py-2.5 text-center text-xs font-semibold text-paper shadow-lg sm:-bottom-3 sm:left-8 sm:right-auto sm:px-4 sm:py-3 sm:text-left sm:text-sm" data-jp-wrap>
        スクショ + 話す → 完了
      </p>
    </div>
  </div>
</section>

<style>
  .shapeit-capture-visual {
    padding-bottom: 1.75rem;
  }

  @media (min-width: 640px) {
    .shapeit-capture-visual {
      padding-bottom: 1.25rem;
    }
  }

  .shapeit-capture-img {
    animation: shapeit-soft-float 7s ease-in-out infinite;
  }

  @keyframes shapeit-soft-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  @media (max-width: 639px), (prefers-reduced-motion: reduce) {
    .shapeit-capture-img {
      animation: none;
    }
  }
</style>
