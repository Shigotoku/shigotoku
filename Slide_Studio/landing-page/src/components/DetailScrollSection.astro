---
import { assetPath } from '../lib/urls';

const heroPhoto = assetPath('images/deckit-story-hero.jpg');
const storyPhotos = [
  {
    src: assetPath('images/deckit-story-create.jpg'),
    label: 'すぐつくる',
    caption: 'Drive の素材から、たたき台まで一気に。',
  },
  {
    src: assetPath('images/deckit-story-edit.jpg'),
    label: 'すぐ直す',
    caption: 'Slides で手直し。Style も相手に合わせて。',
  },
  {
    src: assetPath('images/deckit-story-present.jpg'),
    label: '伝わる',
    caption: 'プレゼン・資料づくりが、自信につながる。',
  },
];

const pillars = [
  {
    title: 'Google Drive ネイティブ',
    body: '保存先はあなたの Drive。共有・権限・バージョン管理は Google のまま。DeckIt は「作るスタジオ」、成果物はいつもの Slides です。',
  },
  {
    title: 'Style と Reference',
    body: '会社・個人・用途別の Style で型を固定。良かった完成資料を Reference に残し、次の生成が「らしさ」に近づきます。',
  },
  {
    title: 'AI ＋ 手直し ＋ ひな形',
    body: '元資料から構成案を作り、生成まで支援。出力後は Slides で自由に編集。複数のひな形を使い回せます。',
  },
  {
    title: '資産としてたまる',
    body: 'プロジェクト・Style・お手本が蓄積され、人が変わっても資料のノウハウが残る。作るほど、次が速くなります。',
  },
];

const steps = [
  { n: '1', title: '元資料を選ぶ', body: 'Drive から資料を追加し、プロジェクトに整理します。' },
  { n: '2', title: 'Style と構成', body: '相手・目的に合わせて Style を選び、構成を確認します。' },
  { n: '3', title: '生成して Slides へ', body: '進捗を見ながら Google Slides として Drive に出力します。' },
];
---

<section id="detail" class="deckit-section--lg border-t border-deck-line bg-deck-panel">
  <div class="mx-auto max-w-6xl px-6">
    <div
      class="deckit-story-panel relative overflow-hidden rounded-2xl border border-deck-line shadow-lg shadow-deck-side/10"
      data-reveal
    >
      <img
        src={heroPhoto}
        alt=""
        class="deckit-story-panel__photo absolute inset-0 h-full w-full object-cover object-center"
        width={2400}
        height={1350}
        loading="lazy"
        decoding="async"
      />
      <div class="deckit-story-panel__veil absolute inset-0" aria-hidden="true"></div>

      <div class="relative z-10 grid gap-10 p-8 sm:p-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:items-end lg:gap-12 lg:p-12">
        <div class="max-w-xl text-white">
          <p class="text-sm font-semibold uppercase tracking-widest text-deck-highlight">About DeckIt</p>
          <h2 class="deckit-h2 mt-3 font-bold" data-jp-heading>
            単なる生成ツールではなく、資料づくりの <span class="deckit-em-dark">OS</span>。
          </h2>
          <p class="deckit-lead mt-4 text-[#d5dee6]" data-jp-wrap>
            つくる。直す。伝える。——スライドづくりの流れ全体を、DeckIt と Google Drive で支えます。
          </p>
        </div>

        <ul class="grid gap-3 sm:grid-cols-3">
          {storyPhotos.map((item, i) => (
            <li
              class="deckit-story-card group overflow-hidden rounded-xl border border-white/15 bg-deck-side/40 backdrop-blur-sm"
              data-reveal
              data-reveal-delay={i + 1}
            >
              <div class="relative aspect-[4/3] overflow-hidden">
                <img
                  src={item.src}
                  alt=""
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
                <span
                  class="absolute left-2 top-2 rounded-md bg-deck-highlight/95 px-2 py-0.5 text-xs font-bold text-deck-side"
                >
                  {item.label}
                </span>
              </div>
              <p class="deckit-body px-3 py-2.5 text-[#e8eef2]" data-jp-wrap>{item.caption}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2">
      {pillars.map((p, i) => (
        <article
          class="rounded-xl border border-deck-line bg-deck-bg p-6 transition-shadow duration-300 hover:shadow-md hover:shadow-deck-accent/5"
          data-reveal
          data-reveal-delay={(i % 2) + 1}
        >
          <h3 class="deckit-h3 font-bold text-deck-text" data-jp-heading>{p.title}</h3>
          <p class="deckit-body mt-2 text-deck-muted" data-jp-wrap>{p.body}</p>
        </article>
      ))}
    </div>

    <div class="mt-20">
      <h3 class="deckit-h2 font-bold text-deck-text" data-reveal data-jp-heading>使い方（3ステップ）</h3>
      <ol class="mt-8 grid gap-4 sm:grid-cols-3">
        {steps.map((s, i) => (
          <li class="rounded-xl border border-deck-line bg-deck-bg p-5" data-reveal data-reveal-delay={i + 1}>
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-deck-highlight text-sm font-bold text-deck-side">
              {s.n}
            </span>
            <p class="mt-3 font-semibold text-deck-text" data-jp-heading>{s.title}</p>
            <p class="deckit-body mt-1 text-deck-muted" data-jp-wrap>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .deckit-story-panel {
    min-height: min(72vh, 36rem);
  }

  .deckit-story-panel__veil {
    background:
      linear-gradient(180deg, rgba(16, 20, 25, 0.55) 0%, rgba(16, 20, 25, 0.82) 55%, rgba(16, 20, 25, 0.92) 100%),
      linear-gradient(105deg, rgba(16, 20, 25, 0.88) 0%, rgba(16, 20, 25, 0.45) 52%, rgba(15, 108, 120, 0.25) 100%);
  }

  @media (min-width: 64rem) {
    .deckit-story-panel {
      min-height: min(68vh, 34rem);
    }

    .deckit-story-panel__photo {
      object-position: center 30%;
    }
  }
</style>
