---
import { appPath } from '../lib/urls';

const loginUrl = appPath('/login');
---

<section
  class="flex min-h-[100svh] flex-col items-center justify-center gap-6 bg-deck-side px-6 text-center text-white"
  aria-label="DeckIt"
>
  <div class="space-y-2">
    <h1 class="text-5xl font-bold tracking-tight sm:text-6xl">DeckIt</h1>
    <p class="text-2xl font-medium text-deck-accent-soft sm:text-3xl">資料、できた。</p>
  </div>

  <p class="max-w-lg text-lg text-[#c8d4dc] sm:text-xl" data-jp-wrap>
    Google アカウントでログインしてください。
  </p>

  <a
    href={loginUrl}
    class="deckit-tap rounded-lg bg-white px-8 py-3 text-base font-semibold text-deck-side shadow-md transition-colors hover:bg-deck-accent-soft"
  >
    Google でログイン
  </a>

  <p class="absolute bottom-[max(1.25rem,env(safe-area-inset-bottom))] text-xs text-[#9fb0bc]">
    <a href="https://shigotoku.com/" class="hover:text-[#c8d4dc]">株式会社シゴトク</a>
  </p>
</section>

<style>
  section {
    position: relative;
  }
</style>
