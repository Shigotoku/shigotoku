# PreDeck Web 版 ローカル開発用（PreDeck/app/.env.local にコピー）
# Firebase Console → shigotoku-predeck-prod → プロジェクトの設定 → Web アプリ

# AI 中継 API の URL（未設定なら同一オリジンの /api。本番は Hosting の rewrite で predeckApi へ）
VITE_PREDECK_API_URL=http://localhost:5001/shigotoku-predeck-prod/asia-northeast1/predeckApi/api

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=shigotoku-predeck-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=shigotoku-predeck-prod
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
