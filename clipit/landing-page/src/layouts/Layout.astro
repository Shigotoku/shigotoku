---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Analytics from '../components/Analytics.astro';
import { appPath, sitePath, assetPath, clipitIconPath } from '../lib/urls';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'クリッピット (ClipIt) - 操作するだけ。教える手間が、マニュアルに変わる。',
} = Astro.props;
const loginUrl = appPath('/login');
const homeUrl = import.meta.env.BASE_URL;
const howUrl = `${homeUrl}#how-it-works`;
const featuresUrl = `${homeUrl}#features`;
const pricingAnchorUrl = `${homeUrl}#pricing`;
const faqUrl = `${homeUrl}#faq`;
const pricingUrl = sitePath('pricing');
const contactUrl = 'https://shigotoku.com/';
---

<!doctype html>
<html lang="ja" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={new URL(clipitIconPath, Astro.site)} />
    <link rel="apple-touch-icon" href={new URL(clipitIconPath, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <Seo title={title} description={description} />
    <Analytics />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white font-sans antialiased">
    <header class="sticky top-0 z-50 border-b border-slate-200/60 bg-white/95 backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6">
        <a href={homeUrl} class="flex items-center gap-2.5 transition-opacity hover:opacity-80">
          <span class="clipit-icon-frame clipit-icon-frame--header">
            <img src={clipitIconPath} alt="クリッピット" class="clipit-brand-icon" width="36" height="36" />
          </span>
          <span class="text-base font-bold tracking-tight text-slate-900">クリッピット</span>
        </a>

        <nav class="hidden items-center gap-6 md:flex">
          <a href={howUrl} class="text-sm font-medium text-slate-500 transition-colors hover:text-slate-900">使い方</a>
          <a href={featuresUrl} class="text-sm font-medium text-slate-500 transition-colors hover:text-slate-900">機能</a>
          <a href={pricingAnchorUrl} class="text-sm font-medium text-slate-500 transition-colors hover:text-slate-900">料金</a>
          <a href={faqUrl} class="text-sm font-medium text-slate-500 transition-colors hover:text-slate-900">FAQ</a>
          <a href={loginUrl} class="text-sm font-medium text-slate-500 transition-colors hover:text-slate-900">ログイン</a>
          <a href={loginUrl} class="rounded-lg bg-primary-500 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all hover:bg-primary-600">無料で始める</a>
        </nav>

        <button id="menu-toggle" type="button" class="rounded-lg p-2 text-slate-600 transition-colors hover:bg-slate-100 md:hidden" aria-label="メニューを開く">
          <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
          <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>

      <div id="mobile-menu" class="hidden border-t border-slate-100 bg-white px-4 pb-4 pt-2 md:hidden">
        <a href={howUrl} class="block min-h-[44px] rounded-lg px-3 py-3 text-sm font-medium text-slate-600 hover:bg-slate-50">使い方</a>
        <a href={featuresUrl} class="block min-h-[44px] rounded-lg px-3 py-3 text-sm font-medium text-slate-600 hover:bg-slate-50">機能</a>
        <a href={pricingAnchorUrl} class="block min-h-[44px] rounded-lg px-3 py-3 text-sm font-medium text-slate-600 hover:bg-slate-50">料金</a>
        <a href={faqUrl} class="block min-h-[44px] rounded-lg px-3 py-3 text-sm font-medium text-slate-600 hover:bg-slate-50">FAQ</a>
        <a href={loginUrl} class="block min-h-[44px] rounded-lg px-3 py-3 text-sm font-medium text-slate-600 hover:bg-slate-50">ログイン</a>
        <a href={loginUrl} class="mt-2 block min-h-[44px] rounded-xl bg-primary-500 px-4 py-3.5 text-center text-sm font-semibold text-white">無料で始める</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-slate-200/60 bg-white/50 py-12">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
          <div class="col-span-2 sm:col-span-1">
            <a href={homeUrl} class="inline-flex items-center gap-2.5">
              <span class="clipit-icon-frame clipit-icon-frame--footer">
                <img src={clipitIconPath} alt="" class="clipit-brand-icon" width="40" height="40" />
              </span>
              <span class="text-sm font-bold text-slate-900">クリッピット</span>
            </a>
            <p class="mt-3 max-w-xs text-sm leading-relaxed text-slate-500">
              操作するだけで業務マニュアルが完成。Chrome拡張で記録し、共有・印刷まで。
            </p>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-slate-900">プロダクト</h3>
            <ul class="mt-3 space-y-2">
              <li><a href={howUrl} class="text-sm text-slate-500 hover:text-slate-700">使い方</a></li>
              <li><a href={featuresUrl} class="text-sm text-slate-500 hover:text-slate-700">機能</a></li>
              <li><a href={pricingUrl} class="text-sm text-slate-500 hover:text-slate-700">料金プラン</a></li>
              <li><a href={faqUrl} class="text-sm text-slate-500 hover:text-slate-700">よくある質問</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-slate-900">サポート</h3>
            <ul class="mt-3 space-y-2">
              <li><a href={loginUrl} class="text-sm text-slate-500 hover:text-slate-700">ログイン</a></li>
              <li><a href={contactUrl} class="text-sm text-slate-500 hover:text-slate-700">お問い合わせ（運営会社）</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-slate-900">法務</h3>
            <ul class="mt-3 space-y-2">
              <li><a href="https://shigotoku.com/terms/" class="text-sm text-slate-500 hover:text-slate-700">利用規約</a></li>
              <li><a href="https://shigotoku.com/privacy/" class="text-sm text-slate-500 hover:text-slate-700">プライバシーポリシー</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-slate-900">会社情報</h3>
            <ul class="mt-3 space-y-2">
              <li><a href="https://shigotoku.com/" class="text-sm text-slate-500 hover:text-slate-700">運営会社</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-10 border-t border-slate-200/60 pt-6 text-center">
          <p class="text-sm text-slate-400">&copy; 2026 クリッピット (ClipIt) / 株式会社シゴトク. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const openIcon = document.getElementById('menu-icon-open');
      const closeIcon = document.getElementById('menu-icon-close');

      toggle?.addEventListener('click', () => {
        const isOpen = !menu?.classList.contains('hidden');
        menu?.classList.toggle('hidden', isOpen);
        openIcon?.classList.toggle('hidden', !isOpen);
        closeIcon?.classList.toggle('hidden', isOpen);
        document.body.style.overflow = isOpen ? '' : 'hidden';
      });

      menu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          menu?.classList.add('hidden');
          openIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
          document.body.style.overflow = '';
        });
      });
    </script>
  </body>
</html>
