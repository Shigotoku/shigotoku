---
const rows = [
  { feature: '月額（小規模向け）', clipit: '980円〜', other: '数万円〜' },
  { feature: '操作記録 + AI手順文', clipit: '標準', other: '製品による' },
  { feature: '既読確認', clipit: '低価格で提供', other: '高額プランのみ' },
  { feature: '日本語・紙運用', clipit: '最適化', other: '海外ツールは弱い' },
  { feature: '導入', clipit: '5分・Googleログイン', other: '営業・初期設定' },
];
---

<section class="clipit-section bg-slate-50 py-12 sm:py-20">
  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    <div class="text-center">
      <h2 class="clipit-h2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl" data-jp-heading>
        大手ツールと正面から戦わない
      </h2>
      <p class="clipit-lead mt-3 text-base text-slate-600 sm:mt-4 sm:text-lg" data-jp-wrap>
        安い・簡単・すぐ使える。国内の小規模現場に振り切った設計です。
      </p>
    </div>

    <!-- モバイル：カード表示 -->
    <div class="clipit-compare-cards mt-10 space-y-3 sm:mt-12">
      {rows.map((r) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
          <p class="text-sm font-bold text-slate-900" data-jp-wrap>{r.feature}</p>
          <div class="mt-3 grid grid-cols-2 gap-3 text-sm">
            <div class="rounded-xl bg-primary-50 px-3 py-2.5">
              <p class="text-[10px] font-semibold text-primary-700">クリッピット</p>
              <p class="mt-1 font-semibold text-slate-900" data-jp-wrap>{r.clipit}</p>
            </div>
            <div class="rounded-xl bg-slate-50 px-3 py-2.5">
              <p class="text-[10px] font-semibold text-slate-500">従来ツール</p>
              <p class="mt-1 text-slate-600" data-jp-wrap>{r.other}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- デスクトップ：テーブル -->
    <div class="clipit-compare-table mt-12 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[32rem] text-left text-sm">
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50/80">
              <th class="px-5 py-4 font-semibold text-slate-600"></th>
              <th class="px-5 py-4 font-bold text-primary-700">クリッピット</th>
              <th class="px-5 py-4 font-semibold text-slate-500">従来のマニュアルツール</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class="border-b border-slate-50 last:border-0">
                <td class="px-5 py-4 font-medium text-slate-800">{r.feature}</td>
                <td class="px-5 py-4 font-semibold text-slate-900">{r.clipit}</td>
                <td class="px-5 py-4 text-slate-500">{r.other}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
