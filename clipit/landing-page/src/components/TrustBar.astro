---
const stats = [
  { value: '5分', label: '初回マニュアル完成' },
  { value: '2,980円', label: '主力プラン（月額）' },
  { value: '0円', label: '初期費用' },
  { value: 'A4·QR', label: '紙文化に最適' },
];
---

<section class="border-y border-slate-200 bg-white py-8 sm:py-10">
  <div class="clipit-grid-safe mx-auto grid max-w-7xl grid-cols-2 gap-6 px-4 sm:grid-cols-4 sm:gap-8 sm:px-6">
    {stats.map((s) => (
      <div class="min-w-0 text-center">
        <p class="text-xl font-extrabold text-primary-600 sm:text-2xl lg:text-3xl" data-jp-wrap>{s.value}</p>
        <p class="mt-1 text-xs text-slate-500 sm:text-sm" data-jp-wrap>{s.label}</p>
      </div>
    ))}
  </div>
</section>
