---
const features = [
  {
    icon: '01',
    title: '操作を記録するだけ',
    body: 'Chrome拡張でクリックごとにスクショと手順を自動取得。赤枠・番号付きで「どこを押すか」が一目です。',
  },
  {
    icon: '02',
    title: 'AIが日本語の手順文を生成',
    body: 'かんたん・丁寧・業務マニュアル風。新人向け・患者向けなど、読む人に合わせた文案に整えます。',
  },
  {
    icon: '03',
    title: 'まとめて修正で古くならない',
    body: 'システム名や連絡先が変わっても、全マニュアルを横断検索してAIが変更候補を提案。確認してから一括適用。',
  },
  {
    icon: '04',
    title: '印刷・QR・スマホで現場に届く',
    body: 'A4印刷、QRコード、スマホ閲覧。個人情報はマスキングし、公開前に隠し忘れ確認を通します。',
  },
];
---

<section id="features" class="clipit-features clipit-section bg-[#fff9f5] py-12 sm:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="text-center">
      <p class="text-sm font-bold uppercase tracking-widest text-primary-600">Features</p>
      <h2 class="clipit-h2 mt-3 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl lg:text-4xl" data-jp-heading>
        ClipIt の<span class="text-primary-600">4つ</span>の特徴
      </h2>
      <p class="clipit-lead mx-auto mt-4 max-w-2xl text-base font-medium text-slate-700 sm:text-lg" data-jp-wrap>
        作る・直す・届ける。マニュアル管理に必要なことだけ、シンプルに。
      </p>
    </div>
    <div class="clipit-grid-safe mt-10 grid gap-5 sm:grid-cols-2 sm:gap-6">
      {features.map((f) => (
        <div class="group min-w-0 rounded-2xl border border-primary-200/60 bg-white p-5 shadow-md shadow-primary-500/5 transition-all hover:border-primary-400 hover:shadow-lg hover:shadow-primary-500/10 sm:p-6">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary-500 text-sm font-bold text-white shadow-md shadow-primary-500/25 transition-transform group-hover:scale-105">
            {f.icon}
          </span>
          <h3 class="clipit-h3 mt-4 text-lg font-extrabold text-slate-900 sm:text-xl" data-jp-heading>{f.title}</h3>
          <p class="clipit-body mt-2.5 text-sm leading-relaxed text-slate-600 sm:text-base" data-jp-wrap>{f.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
