---
import { appPath } from '../lib/urls';

const signupUrl = appPath('/login');
const methods = [
  {
    title: 'クリック操作を記録して作る',
    body: 'Chrome拡張で操作すると、スクショ付き手順が自動でたまります。',
    badge: 'おすすめ',
  },
  {
    title: '話して作成',
    body: 'Google Meetの文字起こしとスクショをAIが統合。暗黙知やNG例も残せます。',
    badge: '差別化',
  },
  {
    title: 'スクショから作る',
    body: '撮っておいた画像をアップロードして、手順書にします。',
    badge: '',
  },
  {
    title: 'テンプレートから作る',
    body: 'クリニック・中小向けの型から素早くスタート。',
    badge: '',
  },
];
---

<section id="create-methods" class="clipit-section border-y border-slate-100 bg-slate-50/60 py-10 sm:py-14">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="text-center">
      <h2 class="clipit-h2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl" data-jp-heading>マニュアルの作り方を選ぶ</h2>
      <p class="clipit-lead mt-3 text-base text-slate-600" data-jp-wrap>現場に合った4つの方法。Chrome拡張・Google Meet・スクショ・テンプレートから始められます。</p>
    </div>
    <p class="mx-auto mt-6 max-w-2xl rounded-xl border border-slate-200 bg-white px-4 py-3 text-center text-sm text-slate-600" data-jp-wrap>
      操作だけでは伝わらない注意点は<strong class="font-semibold text-slate-800">話して作成</strong>が向いています。
      Meetで画面共有 → 文字起こし貼り付け → スクショとAI統合。
    </p>
    <div class="clipit-grid-safe mt-6 grid gap-3 sm:grid-cols-2 sm:gap-4">
      {methods.map((m) => (
        <div class="relative min-w-0 rounded-2xl border border-slate-200 bg-white p-4 sm:p-5">
          {m.badge && (
            <span class="absolute right-3 top-3 rounded-full bg-primary-100 px-2 py-0.5 text-[10px] font-bold text-primary-700">
              {m.badge}
            </span>
          )}
          <h3 class="clipit-h3 pr-16 text-sm font-bold text-slate-900 sm:text-base" data-jp-heading>{m.title}</h3>
          <p class="clipit-body mt-2 text-sm leading-relaxed text-slate-600" data-jp-wrap>{m.body}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 text-center">
      <a href={signupUrl} class="inline-flex rounded-xl bg-primary-500 px-6 py-3 text-sm font-bold text-white hover:bg-primary-400">
        無料で試す（Googleログイン）
      </a>
    </p>
  </div>
</section>
