---
const steps = [
  {
    num: '1',
    title: 'Chrome拡張で操作を記録',
    body: 'いつも通り業務画面を操作するだけ。クリックごとにスクショと手順が自動で溜まります。',
  },
  {
    num: '2',
    title: 'AIが手順文を整える',
    body: 'クリック位置に赤枠・番号を付与。新人にも伝わる日本語の説明文を自動生成します。',
  },
  {
    num: '3',
    title: 'PDF・QR・スマホで共有',
    body: 'A4印刷、現場用QR、スマホ表示。既読確認で「読んだか」も低コストで管理できます。',
  },
];
---

<section id="how-it-works" class="clipit-section border-y border-slate-100 bg-white py-12 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="text-center">
      <h2 class="clipit-h2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl" data-jp-heading>使い方は、3ステップ</h2>
      <p class="clipit-lead mt-3 text-base text-slate-600 sm:mt-4 sm:text-lg" data-jp-wrap>専門知識は不要。初回マニュアルは最短10分で完成します。</p>
    </div>
    <ol class="clipit-grid-safe mt-10 grid gap-5 sm:mt-14 sm:gap-8 md:grid-cols-3">
      {steps.map((s) => (
        <li class="relative rounded-2xl border border-slate-200 bg-slate-50/50 p-5 sm:p-8">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary-500 text-lg font-bold text-white">
            {s.num}
          </span>
          <h3 class="clipit-h3 mt-4 text-base font-bold text-slate-900 sm:text-lg" data-jp-heading>{s.title}</h3>
          <p class="clipit-body mt-3 text-sm leading-relaxed text-slate-600" data-jp-wrap>{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
