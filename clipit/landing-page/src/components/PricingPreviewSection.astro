---
import { appPath, sitePath } from '../lib/urls';

const loginUrl = appPath('/login');
const pricingUrl = sitePath('pricing');

const plans = [
  {
    name: 'フリー',
    price: '0',
    note: 'お試し・月3本',
    features: ['Chrome拡張で記録', 'PDF / 共有URL', '透かしあり'],
    highlight: false,
  },
  {
    name: 'スタンダード',
    price: '2,980',
    note: 'クリニック・中小の主力',
    features: ['月50本', '既読確認・テンプレ', 'スタッフ招待・QR'],
    highlight: true,
  },
  {
    name: 'ビジネス',
    price: '5,980',
    note: '複数部署・教育管理',
    features: ['月200本', '未読者一覧', 'スタッフ管理'],
    highlight: false,
  },
];
---

<section id="pricing" class="clipit-section bg-slate-50 py-12 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary-600">Pricing</p>
      <h2 class="clipit-h2 mt-3 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl" data-jp-heading>わかりやすい定額。席課金なし。</h2>
      <p class="clipit-lead mt-3 text-base text-slate-600 sm:mt-4" data-jp-wrap>
        1施設・1社単位。初期費用0円。年払いは2ヶ月分無料。
      </p>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {plans.map((p) => (
        <div
          class={`flex flex-col rounded-2xl border bg-white p-6 shadow-sm ${
            p.highlight ? 'border-primary-400 ring-2 ring-primary-200' : 'border-slate-200'
          }`}
        >
          {p.highlight && (
            <span class="mb-3 w-fit rounded-full bg-primary-500 px-3 py-1 text-xs font-bold text-white">おすすめ</span>
          )}
          <h3 class="text-lg font-bold text-slate-900">{p.name}</h3>
          <p class="mt-1 text-sm text-slate-500">{p.note}</p>
          <p class="mt-4">
            <span class="text-4xl font-extrabold text-slate-900">{p.price}</span>
            <span class="text-sm text-slate-400">円/月</span>
          </p>
          <ul class="mt-6 flex-1 space-y-2">
            {p.features.map((f) => (
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-primary-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.1 3.1 6.8-6.8a1 1 0 0 1 1.4 0z" clip-rule="evenodd"/>
                </svg>
                {f}
              </li>
            ))}
          </ul>
          <a
            href={loginUrl}
            class={`mt-6 block rounded-xl py-3 text-center text-sm font-semibold transition-all ${
              p.highlight
                ? 'bg-primary-500 text-white hover:bg-primary-600'
                : 'border border-slate-300 text-slate-700 hover:border-slate-400'
            }`}
          >
            無料で始める
          </a>
        </div>
      ))}
    </div>
    <p class="mt-8 text-center">
      <a href={pricingUrl} class="text-sm font-semibold text-primary-600 hover:text-primary-700 hover:underline">
        全プランの詳細を見る →
      </a>
    </p>
  </div>
</section>
