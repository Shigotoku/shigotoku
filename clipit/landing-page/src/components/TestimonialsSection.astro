---
const quotes = [
  {
    role: 'クリニック・事務長',
    text: '電子カルテの操作を、口頭で何度も説明する時間が半分になりました。紙にQRを貼れば、パートさんも自分のペースで確認できます。',
  },
  {
    role: '中小企業・総務',
    text: '請求書発行の手順を、属人化せず共有できました。マスキング確認があるので、安心して共有できます。',
  },
  {
    role: 'スタートアップ・CS',
    text: '管理画面のヘルプを、操作記録からすぐ作れるのが強み。海外ツールより日本語の自然さが段違いです。',
  },
];
---

<section class="clipit-section py-12 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary-600">Voice</p>
      <h2 class="clipit-h2 mt-3 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl" data-jp-heading>現場の声（導入イメージ）</h2>
      <p class="clipit-lead mt-3 text-base text-slate-600 sm:mt-4 sm:text-lg" data-jp-wrap>医療・中小・スタートアップで想定される利用シーンです。</p>
    </div>
    <div class="clipit-grid-safe mt-10 grid gap-5 sm:mt-14 sm:gap-6 md:grid-cols-3">
      {quotes.map((q) => (
        <blockquote class="flex min-w-0 flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
          <p class="flex-1 text-sm leading-relaxed text-slate-600" data-jp-wrap>「{q.text}」</p>
          <footer class="mt-6 text-xs font-semibold text-primary-700">{q.role}</footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>
