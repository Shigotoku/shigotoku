---
import Layout from '../layouts/Layout.astro';
import { appPath, clipitIconPath } from '../lib/urls';

const loginUrl = appPath('/login');

const plans = [
  {
    name: 'フリー',
    price: '0',
    target: 'お試し',
    features: ['月3本まで', '透かしあり', 'PDF / 共有URL', 'Chrome拡張で記録', '手動マスキング'],
    highlight: false,
  },
  {
    name: 'ライト',
    price: '980',
    target: '個人・小規模',
    features: ['月10本まで', '透かしなし', 'PDF / QR', '公開前の隠し忘れ確認'],
    highlight: false,
  },
  {
    name: 'スタンダード',
    price: '2,980',
    target: 'クリニック・中小企業',
    features: ['月50本まで', '既読確認', 'テンプレート', 'スタッフ招待', '共有URL・QR'],
    highlight: true,
  },
  {
    name: 'ビジネス',
    price: '5,980',
    target: '複数部署',
    features: ['月200本まで', '未読者一覧', 'スタッフ管理', '教育チェック'],
    highlight: false,
  },
];
---

<Layout title="料金プラン - クリッピット (ClipIt)" description="初期費用0円・無料あり・主力プラン月額2,980円。1施設1社のわかりやすい定額。">
  <section class="relative overflow-hidden bg-slate-950 py-14 text-center sm:py-20">
    <div class="clipit-pricing-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-4 sm:px-6">
      <span class="clipit-icon-frame clipit-icon-frame--hero mx-auto shadow-lg shadow-primary-500/30">
        <img src={clipitIconPath} alt="" class="clipit-brand-icon" width="96" height="96" />
      </span>
      <h1 class="clipit-h1 mt-5 text-2xl font-extrabold tracking-tight text-white sm:mt-6 sm:text-4xl lg:text-5xl" data-jp-heading>シンプルな料金</h1>
      <p class="clipit-lead mt-3 text-base text-slate-400 sm:mt-4 sm:text-lg" data-jp-wrap>席課金なし。1施設・1社単位。年払いは2ヶ月分無料。</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="clipit-grid-safe grid gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
      {plans.map((p) => (
        <div class={`flex flex-col rounded-2xl border bg-white p-6 ${p.highlight ? 'border-primary-400 shadow-xl shadow-primary-500/10 ring-2 ring-primary-200 lg:scale-[1.02]' : 'border-slate-200 shadow-sm'}`}>
          {p.highlight && (
            <span class="mb-3 inline-flex w-fit rounded-full bg-primary-500 px-3 py-1 text-xs font-bold text-white">いちばん人気</span>
          )}
          <h2 class="text-lg font-bold text-slate-900">{p.name}</h2>
          <p class="mt-1 text-sm text-slate-500">{p.target}</p>
          <p class="mt-4">
            <span class="text-4xl font-extrabold text-slate-900">{p.price}</span>
            <span class="text-base font-medium text-slate-400">円/月</span>
          </p>
          <ul class="mt-6 flex-1 space-y-2.5">
            {p.features.map((f) => (
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-primary-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.1 3.1 6.8-6.8a1 1 0 0 1 1.4 0z" clip-rule="evenodd"/>
                </svg>
                {f}
              </li>
            ))}
          </ul>
          <a
            href={loginUrl}
            class={`mt-6 rounded-xl px-4 py-3 text-center text-sm font-semibold transition-all ${p.highlight ? 'bg-primary-500 text-white hover:bg-primary-600' : 'border border-slate-300 text-slate-700 hover:border-slate-400'}`}
          >
            無料で始める
          </a>
        </div>
      ))}
    </div>

    <div class="mt-16 rounded-2xl border border-slate-200 bg-slate-50 p-8 text-center">
      <h2 class="text-lg font-bold text-slate-900">開発者・代理店プラン</h2>
      <p class="mt-2 text-sm text-slate-600">
        開発者プラン（月額9,800円〜）・代理店/士業プラン（月額19,800円〜）はお問い合わせください。
      </p>
    </div>
  </section>
</Layout>

<style>
  .clipit-pricing-glow {
    background: radial-gradient(ellipse 70% 50% at 50% 0%, rgba(249, 115, 22, 0.3), transparent);
  }
</style>
