---
import Layout from '../layouts/Layout.astro';
import { appPath } from '../lib/urls';

const loginUrl = appPath('/login');

const plans = [
  {
    name: 'フリー',
    price: '0円',
    target: 'お試し',
    features: ['月3本まで', '透かしあり', 'PDF / 共有URL', 'Chrome拡張で記録'],
    highlight: false,
  },
  {
    name: 'ライト',
    price: '980円',
    target: '個人・小規模',
    features: ['月10本まで', 'PDF / QR', '手動マスキング', '公開前の隠し忘れ確認'],
    highlight: false,
  },
  {
    name: 'スタンダード',
    price: '2,980円',
    target: 'クリニック・中小企業',
    features: ['月50本まで', '既読確認', 'テンプレート', 'スタッフ招待', '共有URL'],
    highlight: true,
  },
  {
    name: 'ビジネス',
    price: '5,980円',
    target: '複数部署',
    features: ['月200本まで', 'スタッフ管理', '教育チェック', '未読者一覧'],
    highlight: false,
  },
];
---

<Layout title="料金プラン - クリッピット (ClipIt)" description="クリッピットの料金プラン。初期費用0円・無料あり・主力プラン月額2,980円。">
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
    <div class="text-center">
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900">シンプルな料金</h1>
      <p class="mt-4 text-lg text-slate-600">初期費用0円。1施設・1社単位のわかりやすい定額。年払いは2ヶ月分無料。</p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-4">
      {plans.map((p) => (
        <div class={`flex flex-col rounded-2xl border bg-white p-6 shadow-sm ${p.highlight ? 'border-primary-400 ring-2 ring-primary-200' : 'border-slate-200'}`}>
          {p.highlight && (
            <span class="mb-3 inline-flex w-fit rounded-full bg-primary-500 px-3 py-1 text-xs font-bold text-white">主力プラン</span>
          )}
          <h2 class="text-lg font-bold text-slate-900">{p.name}</h2>
          <p class="mt-1 text-sm text-slate-500">{p.target}</p>
          <p class="mt-4 text-3xl font-extrabold text-slate-900">{p.price}<span class="text-base font-medium text-slate-400">/月</span></p>
          <ul class="mt-6 flex-1 space-y-2.5">
            {p.features.map((f) => (
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-primary-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.1 3.1 6.8-6.8a1 1 0 0 1 1.4 0z" clip-rule="evenodd"/></svg>
                {f}
              </li>
            ))}
          </ul>
          <a href={loginUrl} class={`mt-6 rounded-xl px-4 py-3 text-center text-sm font-semibold transition-all ${p.highlight ? 'bg-primary-500 text-white hover:bg-primary-600' : 'border border-slate-300 text-slate-700 hover:border-slate-400'}`}>
            このプランで始める
          </a>
        </div>
      ))}
    </div>

    <p class="mt-10 text-center text-sm text-slate-500">
      開発者プラン（月額9,800円〜）・代理店/士業プラン（月額19,800円〜）もご用意しています。
    </p>
  </section>
</Layout>
