---
import Layout from '../layouts/Layout.astro';
import HowItWorksSection from '../components/HowItWorksSection.astro';
import FaqSection from '../components/FaqSection.astro';
import { appPath, sitePath } from '../lib/urls';

const loginUrl = appPath('/login');
const pricingUrl = sitePath('pricing');

const features = [
  {
    title: 'Chrome拡張で操作を記録',
    body: 'いつも通り画面を操作するだけ。クリックごとにスクショと手順を自動で取得します。',
  },
  {
    title: 'AIが日本語の手順文を生成',
    body: 'クリックした要素やページから、新人にも伝わる自然な日本語の説明文を自動作成。',
  },
  {
    title: '赤枠・番号を自動で付与',
    body: 'クリック位置に赤枠と番号を自動表示。迷わないマニュアルに仕上がります。',
  },
  {
    title: '手動マスキングで個人情報を保護',
    body: 'ドラッグで黒塗り・モザイク。公開前に「隠し忘れ確認」を必ず通します。',
  },
  {
    title: 'A4印刷・QR・スマホ表示',
    body: '紙に貼るA4 PDF、現場で読み取るQRコード、スマホ縦スクロール表示に最適化。',
  },
  {
    title: '既読確認で教育管理',
    body: '「確認しました」ボタンと履歴で、誰が読んだかを低価格で管理できます。',
  },
];

const audiences = [
  { tag: 'クリニック', body: '電子カルテ・受付・会計・予約システムの操作を、教える手間なく共有。' },
  { tag: '中小企業', body: '請求書発行・経費精算・入退社手続きの属人化を解消。' },
  { tag: 'スタートアップ', body: 'SaaSのヘルプページや管理画面の説明を爆速で生成。' },
];
---

<Layout title="クリッピット (ClipIt) - 操作するだけで、業務マニュアルが完成">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-primary-50 to-white">
    <div class="mx-auto max-w-7xl px-4 py-20 text-center sm:px-6 sm:py-28">
      <span class="inline-flex items-center rounded-full bg-primary-100 px-4 py-1.5 text-sm font-semibold text-primary-700">
        小さな会社のための“業務の教え方”SaaS
      </span>
      <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        操作するだけ。<br />教える手間が、マニュアルに変わる。
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">
        Chrome拡張で記録 → AIが日本語の手順を生成 → A4 PDF・QR・スマホで共有。
        新人に何度も同じことを教える時間を、クリッピットがなくします。
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={loginUrl} class="w-full rounded-xl bg-primary-500 px-8 py-4 text-base font-semibold text-white shadow-lg shadow-primary-500/30 transition-all hover:bg-primary-600 sm:w-auto">
          無料で始める
        </a>
        <a href={pricingUrl} class="w-full rounded-xl border border-slate-300 bg-white px-8 py-4 text-base font-semibold text-slate-700 transition-all hover:border-slate-400 sm:w-auto">
          料金を見る
        </a>
      </div>
      <p class="mt-4 text-sm text-slate-400">初期費用0円 / 主力プラン 月額2,980円 / 5分で初回作成</p>
    </div>
  </section>

  <HowItWorksSection />

  <!-- Features -->
  <section id="features" class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
    <div class="text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900">迷わない。止まらない。間違えにくい。</h2>
      <p class="mt-4 text-lg text-slate-600">高機能より「現場で使える」を優先したマニュアル作成SaaSです。</p>
    </div>
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all hover:border-primary-200 hover:shadow-md">
          <h3 class="text-lg font-bold text-slate-900">{f.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Audiences -->
  <section class="bg-slate-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900">こんな現場で使われています</h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-3">
        {audiences.map((a) => (
          <div class="rounded-2xl bg-white p-8 shadow-sm">
            <span class="inline-flex rounded-full bg-primary-100 px-3 py-1 text-sm font-semibold text-primary-700">{a.tag}</span>
            <p class="mt-4 text-sm leading-relaxed text-slate-600">{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FaqSection />

  <!-- CTA -->
  <section class="mx-auto max-w-4xl px-4 py-24 text-center sm:px-6">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900">まずは1本、作ってみてください。</h2>
    <p class="mt-4 text-lg text-slate-600">登録からマニュアル完成まで、最短10分。閲覧する側はログインも拡張も不要です。</p>
    <a href={loginUrl} class="mt-8 inline-flex rounded-xl bg-primary-500 px-10 py-4 text-base font-semibold text-white shadow-lg shadow-primary-500/30 transition-all hover:bg-primary-600">
      無料で始める
    </a>
  </section>
</Layout>
