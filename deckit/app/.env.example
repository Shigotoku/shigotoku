# mock | firebase （未設定時: Firebase キーがあれば firebase、なければ mock）
NEXT_PUBLIC_DECKIT_DATA_MODE=mock

# Firebase Web（Console の firebaseConfig を .env.local にコピー。ここには実キーを書かない）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin（ローカル API 用）
# JSON は app/secrets/deckit-admin.json に置く（リポジトリ直下・他 PC でも同じ相対パス）
FIREBASE_PROJECT_ID=shigotoku-deckit-prod
GOOGLE_APPLICATION_CREDENTIALS=./secrets/deckit-admin.json
