---
/** アプリ UI（サイドバー + コンポーザ + プレビュー）の簡易モック */
---

<div
  class="overflow-hidden rounded-xl border border-white/10 bg-deck-side-2 shadow-2xl shadow-black/40 ring-1 ring-white/5"
  aria-hidden="true"
>
  <div class="flex h-[min(52vw,14rem)] min-h-[200px] sm:h-[280px]">
    <aside class="flex w-[28%] min-w-[4.5rem] flex-col border-r border-white/10 bg-deck-side px-2 py-2.5 sm:px-3">
      <div class="mb-2 h-2 w-12 rounded bg-white/20"></div>
      <div class="space-y-1.5">
        <div class="h-6 rounded bg-deck-accent/40 ring-1 ring-deck-accent/60"></div>
        <div class="h-6 rounded bg-white/5"></div>
        <div class="h-6 rounded bg-white/5"></div>
      </div>
      <div class="mt-auto pt-2 text-[9px] font-medium text-white/35 sm:text-[10px]">Projects</div>
    </aside>
    <div class="flex min-w-0 flex-1 flex-col bg-[#f7f9fa]">
      <div class="flex min-h-0 flex-1">
        <div class="flex min-w-0 flex-1 flex-col border-r border-deck-line p-2 sm:p-3">
          <div class="mb-2 flex gap-1">
            <span class="rounded bg-deck-accent px-1.5 py-0.5 text-[8px] font-semibold text-white sm:text-[9px]">構成</span>
            <span class="rounded bg-deck-line px-1.5 py-0.5 text-[8px] text-deck-muted sm:text-[9px]">生成</span>
          </div>
          <div class="space-y-1.5">
            <div class="h-2 w-full max-w-[90%] rounded bg-deck-line"></div>
            <div class="h-2 w-4/5 rounded bg-deck-line"></div>
            <div class="mt-2 h-14 rounded-md border border-deck-line bg-white sm:h-16"></div>
          </div>
        </div>
        <div class="hidden w-[38%] flex-col bg-deck-panel p-2 sm:flex sm:p-2.5">
          <div class="mb-1.5 text-[9px] font-medium text-deck-muted">Preview</div>
          <div class="aspect-video w-full rounded border border-deck-line bg-white shadow-sm">
            <div class="flex h-full flex-col justify-center gap-1 p-2">
              <div class="h-1.5 w-2/3 rounded bg-deck-text/80"></div>
              <div class="h-1 w-1/2 rounded bg-deck-muted/40"></div>
              <div class="mt-1 h-1 w-3/4 rounded bg-deck-muted/25"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="flex h-6 items-center justify-between border-t border-deck-line bg-white px-2 text-[8px] text-deck-muted sm:h-7 sm:text-[9px]">
        <span>Ready</span>
        <span class="text-deck-accent">Google Slides</span>
      </div>
    </div>
  </div>
</div>
