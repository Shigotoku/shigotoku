async function deletePreset(){try{const n=$('presetList').value;if(!n)throw Error('削除するプリセットを選択してください。');await call('deleteSlidePreset',n);await refreshPresets();show('presetStatus','削除しました。')}catch(e){show('presetStatus',e.message,true)}}
refreshPresets().catch(e=>show('presetStatus',e.message,true));
const layouts='cover / statement / evidence / two_column / closing';
function makePrompt(){let o;try{o=getOptions()}catch(e){return show('pdfStatus',e.message,true)}const text=files.map(f=>f.text).join('\n\n').slice(0,160000);const profileText=window.currentProfile?JSON.stringify({font:currentProfile.font,textColor:currentProfile.textColor,medianTitleLength:currentProfile.medianTitleLength,medianBodyLength:currentProfile.medianBodyLength,rules:currentProfile.rules}):'未登録';const prompt=`あなたは企業の資料編集者です。以下の作成条件を厳守して、Google Slides差し込み用JSONを出力してください。説明文やMarkdownコードフェンスは禁止。JSONだけを返すこと。元資料にない数字・実績・引用・図表を捏造しない。広告調・AI特有の大げさな言い回しを避ける。タイトルは短く、1枚1メッセージ。各ページの根拠は source:{file,page,note} に記録。画像は生成せず、evidenceページでは使う図表のファイルとページを必ず示す。imagesは空オブジェクトとする。layoutは ${layouts} から選ぶ。各スライドは title,subtitle,message,body,left,right,source,images を必要に応じ持つ。トップレベルは {"title":"...","slides":[...]}。\n\n【デザインDNA（過去資料・承認済みルール）】\n${profileText}\n\n【作成条件】\n${JSON.stringify(o,null,2)}\n厳密に${o.slideCount}枚にする。表紙・締めも枚数に含む。表紙=${o.includeCover?'1枚目をcover':'必須ではない'}。締め=${o.includeClosing?'最終ページをclosing':'必須ではない'}。元資料に情報が不足するときは推測で補わず、確認が必要な点を文中に明示する。\n\n【作成目的・補足】\n${$('brief').value}\n\n【元資料：PDFからの抽出テキスト。図表は元PDFで確認】\n${text||'添付テキストなし。出典を捏造しないこと。'}`;$('prompt').value=prompt;navigator.clipboard?.writeText(prompt).then(()=>show('pdfStatus','プロンプトをコピーしました。')).catch(()=>show('pdfStatus','プロンプト欄からコピーしてください。'));}
function sample(){$('json').value=JSON.stringify({title:'サンプル資料',slides:[{layout:'cover',title:'サンプル資料',subtitle:'会社独自テンプレート'},{layout:'statement',title:'主なポイント',message:'元資料の根拠に基づいて簡潔に説明します。',source:{file:'サンプル',page:1}}]},null,2);check();}
function check(){try{let v=JSON.parse($('json').value.trim().replace(/^```(?:json)?\s*/i,'').replace(/\s*```$/,''));const o=getOptions();if(!Array.isArray(v.slides)||v.slides.length!==o.slideCount)throw Error('指定は'+o.slideCount+'枚ですが、JSONは'+(v.slides||[]).length+'枚です。');if(o.includeCover&&v.slides[0].layout!=='cover')throw Error('1枚目はcoverにしてください。');if(o.includeClosing&&v.slides[v.slides.length-1].layout!=='closing')throw Error('最終ページはclosingにしてください。');v.slides.forEach((s,i)=>{if(!['cover','statement','evidence','two_column','closing'].includes(s.layout)||!s.title)throw Error((i+1)+'枚目のlayout/titleが不正')});$('checkResult').textContent='検証OK：'+v.slides.length+'枚 / '+v.slides.map(s=>s.layout).join(', ');return v;}catch(e){$('checkResult').textContent='JSONエラー: '+e.message;return null;}}
async function generate(){const deck=check();if(!deck)return;const b=$('generate');b.disabled=true;show('result','スライドを生成しています…');try{const res=await call('createDeck',{deck,options:getOptions()});lastDeckUrl=res.url;$('result').innerHTML='完成：<a href="'+res.url+'" target="_blank" rel="noopener">Google Slidesを開く（'+res.count+'枚）</a>'; }catch(e){show('result',e.message,true)}finally{b.disabled=false}}

async function refreshProfile(){try{window.currentProfile=await call('getDesignProfile');const p=currentProfile;$('profileSummary').textContent=JSON.stringify({name:p.name,font:p.font,color:p.textColor,titleLength:p.medianTitleLength,bodyLength:p.medianBodyLength,rules:p.rules,sourceDecks:p.sourceDecks},null,2)}catch(e){show('profileStatus',e.message,true)}}
async function learnReferences(){try{const urls=$('referenceDecks').value.split(/\r?\n/).map(x=>x.trim()).filter(Boolean);await call('learnFromReferenceDecks',urls);await refreshProfile();show('profileStatus','デザインの傾向を保存しました。')}catch(e){show('profileStatus',e.message,true)}}
async function addRule(){try{await call('setProfileRule',$('newRule').value);$('newRule').value='';await refreshProfile();show('profileStatus','ルールを追加しました。')}catch(e){show('profileStatus',e.message,true)}}
async function exportProfile(){try{const x=await call('exportDesignProfile');$('profileStatus').textContent='共有する場合、このJSONのDrive権限を自分で設定してください：'+x.url;}catch(e){show('profileStatus',e.message,true)}}
async function importProfile(){try{await call('importDesignProfile',$('profileUrl').value);await refreshProfile();show('profileStatus','プロフィールを読み込みました。')}catch(e){show('profileStatus',e.message,true)}}
function editedUrl(){const v=lastDeckUrl||prompt('編集済みGoogle SlidesのURLを入力してください。');if(!v)throw Error('資料URLがありません。');return v;}
async function pptx(){try{const x=await call('exportPptx',editedUrl());$('learningResult').textContent='PowerPointファイルをDriveへ保存しました：'+x.url}catch(e){$('learningResult').textContent=e.message}}
async function previewLearning(){try{const x=await call('previewEditedDeckLearning',editedUrl());$('learningResult').textContent=JSON.stringify(x,null,2)}catch(e){$('learningResult').textContent=e.message}}
async function approveLearning(){try{if(!confirm('現在の編集済みGoogle Slidesの書式傾向を、次回の生成に反映しますか？'))return;const x=await call('approveEditedDeckLearning',editedUrl());await refreshProfile();$('learningResult').textContent='学習しました。検出した変更 '+x.changeCount+'件。'}catch(e){$('learningResult').textContent=e.message}}
refreshProfile();
