---
const storyBeats = [
  {
    label: 'すぐつくる',
    caption: '素材から、台本と動画のたたき台まで一気に。',
  },
  {
    label: 'すぐ直す',
    caption: '文言・写真・長さを調整。ルールは会社のまま。',
  },
  {
    label: '伝わる',
    caption: '会社らしい動画で、採用も集客も一歩先へ。',
  },
];

const pillars = [
  {
    title: 'ブランドルールで包む',
    body: 'ロゴ・色・フォント・言い回し・禁止表現を一度登録。どの動画にも自動で適用され、担当者が変わってもトーンが揃います。',
  },
  {
    title: '用途別のテンプレート',
    body: '採用・サービス紹介・お知らせなど、用途別のテンプレートで型を固定。良かった動画を「お手本」に残し、次がもっと早くなります。',
  },
  {
    title: 'AI ＋ 人の確認 ＋ 承認',
    body: '台本のたたき台は AI が支援。事実と表現は人が確認し、承認してから書き出し。承認なしの公開はありません。',
  },
  {
    title: '資産としてたまる',
    body: '素材・ルール・お手本が蓄積され、人が変わっても動画づくりのノウハウが残る。作るほど、次が速くなります。',
  },
];

const steps = [
  { n: '1', title: '素材を選ぶ', body: '写真・動画・文章を追加し、プロジェクトに整理します。' },
  { n: '2', title: 'ルールと台本', body: '用途に合わせてブランドルールを選び、台本を確認します。' },
  { n: '3', title: '生成して承認', body: 'プレビューで確認し、承認して動画を書き出します。' },
];
---

<section id="detail" class="border-t border-wrap-line bg-wrap-panel">
  <div class="wrapit-os-bleed relative w-full overflow-hidden" data-reveal>
    <div class="absolute inset-0 bg-wrap-side" aria-hidden="true"></div>
    <div class="wrapit-os-bleed__veil absolute inset-0" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto flex min-h-[min(88vh,40rem)] max-w-6xl flex-col justify-between px-6 py-14 sm:px-8 sm:py-16 lg:py-20">
      <div class="max-w-2xl text-white">
        <p class="text-sm font-semibold uppercase tracking-widest text-wrap-highlight">About WrapIt</p>
        <h2 class="wrapit-h2 mt-3 font-bold" data-jp-heading>
          単なる動画生成ではなく、会社らしさを守る<span class="wrapit-em-dark">仕組み</span>。
        </h2>
        <p class="wrapit-lead mt-4 text-[#d5dee6]" data-jp-wrap>
          つくる。確認する。承認する。——ショート動画づくりの流れ全体を、WrapIt が支えます。
        </p>
      </div>

      <ul class="mt-12 grid gap-4 border-t border-white/15 pt-8 sm:grid-cols-3 sm:gap-6">
        {storyBeats.map((item, i) => (
          <li
            class="rounded-xl border border-white/20 bg-wrap-side/35 px-4 py-4 backdrop-blur-md sm:px-5 sm:py-5"
            data-reveal
            data-reveal-delay={i + 1}
          >
            <p class="text-lg font-bold text-wrap-highlight sm:text-xl">{item.label}</p>
            <p class="wrapit-body mt-2 text-[#e8eef2]" data-jp-wrap>{item.caption}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="wrapit-section--lg mx-auto max-w-6xl px-6">
    <div class="grid gap-5 sm:grid-cols-2">
      {pillars.map((p, i) => (
        <article
          class="rounded-xl border border-wrap-line bg-wrap-bg p-6 transition-shadow duration-300 hover:shadow-md hover:shadow-wrap-accent/5"
          data-reveal
          data-reveal-delay={(i % 2) + 1}
        >
          <h3 class="wrapit-h3 font-bold text-wrap-text" data-jp-heading>{p.title}</h3>
          <p class="wrapit-body mt-2 text-wrap-muted" data-jp-wrap>{p.body}</p>
        </article>
      ))}
    </div>

    <div class="mt-20">
      <h3 class="wrapit-h2 font-bold text-wrap-text" data-reveal data-jp-heading>使い方（3ステップ）</h3>
      <ol class="mt-8 grid gap-4 sm:grid-cols-3">
        {steps.map((s, i) => (
          <li class="rounded-xl border border-wrap-line bg-wrap-bg p-5" data-reveal data-reveal-delay={i + 1}>
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-wrap-highlight text-sm font-bold text-wrap-side">
              {s.n}
            </span>
            <p class="mt-3 font-semibold text-wrap-text" data-jp-heading>{s.title}</p>
            <p class="wrapit-body mt-1 text-wrap-muted" data-jp-wrap>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .wrapit-os-bleed__veil {
    background:
      linear-gradient(180deg, rgba(16, 20, 25, 0.72) 0%, rgba(16, 20, 25, 0.55) 40%, rgba(16, 20, 25, 0.88) 100%),
      linear-gradient(90deg, rgba(16, 20, 25, 0.82) 0%, rgba(16, 20, 25, 0.35) 55%, rgba(109, 63, 214, 0.2) 100%);
  }
</style>
