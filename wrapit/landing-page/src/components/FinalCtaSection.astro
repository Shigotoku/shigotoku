---
import { appPath, FORMSPREE_FORM_ID, WAITLIST_MAIL } from '../lib/urls';

const loginUrl = appPath('/login');
const configured = Boolean(FORMSPREE_FORM_ID);
const input =
  'w-full rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-base text-white placeholder-[#8a9aa6] focus:border-wrap-highlight focus:outline-none focus:ring-2 focus:ring-wrap-highlight/30';
---

<section id="cta" class="wrapit-section bg-wrap-side text-white">
  <div class="mx-auto max-w-xl px-6" data-reveal>
    <div class="text-center">
      <h2 class="wrapit-h2 font-bold" data-jp-heading>まずは、<span class="wrapit-em-dark">1本</span>つくってみる。</h2>
      <p class="wrapit-lead mt-3 text-[#c8d4dc]" data-jp-wrap>
        先行利用を受け付けています。ご登録いただいた方に、提供開始と料金が決まり次第ご案内します。
      </p>
    </div>

    <div class="mt-10 rounded-2xl border border-white/15 bg-white/5 p-6 sm:p-8">
      {!configured && (
        <p class="mb-4 rounded-lg border border-amber-300/40 bg-amber-300/10 px-4 py-3 text-sm text-amber-200">
          フォームは準備中です。お手数ですが <a href={`mailto:${WAITLIST_MAIL}?subject=WrapIt%20先行利用`} class="font-semibold underline">{WAITLIST_MAIL}</a> までご連絡ください。
        </p>
      )}

      <div id="waitlist-success" class="hidden py-8 text-center">
        <p class="text-xl font-bold text-wrap-highlight">登録ありがとうございました</p>
        <p class="mt-2 text-sm text-[#c8d4dc]" data-jp-wrap>準備が整いしだい、ご登録のメールアドレスにご連絡します。</p>
      </div>

      <form id="waitlist-form" class="space-y-4" data-formspree-id={FORMSPREE_FORM_ID}>
        <input type="hidden" name="_subject" value="【WrapIt】先行利用の申し込み" />
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        <div>
          <label for="wl-company" class="mb-1.5 block text-xs font-semibold text-[#c8d4dc]">会社・団体名</label>
          <input id="wl-company" type="text" name="company" placeholder="株式会社〇〇" class={input} />
        </div>
        <div>
          <label for="wl-name" class="mb-1.5 block text-xs font-semibold text-[#c8d4dc]">お名前 <span class="text-wrap-highlight">*</span></label>
          <input id="wl-name" type="text" name="name" required placeholder="山田 太郎" class={input} />
        </div>
        <div>
          <label for="wl-email" class="mb-1.5 block text-xs font-semibold text-[#c8d4dc]">メールアドレス <span class="text-wrap-highlight">*</span></label>
          <input id="wl-email" type="email" name="email" required placeholder="you@example.com" class={input} />
        </div>
        <div>
          <label for="wl-use" class="mb-1.5 block text-xs font-semibold text-[#c8d4dc]">作りたい動画</label>
          <select id="wl-use" name="use_case" class={input}>
            <option class="text-black" value="">選択してください</option>
            <option class="text-black" value="recruit">採用広報</option>
            <option class="text-black" value="notice">お知らせ・キャンペーン</option>
            <option class="text-black" value="service">サービス紹介</option>
            <option class="text-black" value="internal">社内共有</option>
            <option class="text-black" value="other">その他</option>
          </select>
        </div>
        <div class="flex items-start gap-2.5">
          <input id="wl-agree" type="checkbox" name="agree" required class="mt-0.5 h-4 w-4 rounded" />
          <label for="wl-agree" class="text-xs leading-relaxed text-[#c8d4dc]">
            <a href="https://shigotoku.com/privacy" class="underline hover:text-white">プライバシーポリシー</a>に同意する
          </label>
        </div>
        <p id="waitlist-error" class="hidden rounded-lg bg-red-500/15 px-4 py-2.5 text-sm text-red-200"></p>
        <button
          type="submit"
          id="waitlist-submit"
          disabled={!configured}
          class="wrapit-tap w-full rounded-lg bg-wrap-highlight px-6 py-3.5 text-base font-semibold text-wrap-side shadow-md shadow-wrap-highlight/25 transition-colors hover:bg-wrap-accent-soft disabled:cursor-not-allowed disabled:opacity-60"
        >
          先行利用を申し込む
        </button>
      </form>
    </div>

    <p class="mt-8 text-center text-sm text-[#9fb0bc]">
      すでにアカウントをお持ちの方は <a href={loginUrl} class="underline hover:text-white">ログイン</a>
    </p>
  </div>
  <p class="mt-16 text-center text-sm text-[#9fb0bc]">
    <a href="https://shigotoku.com/" class="hover:text-[#c8d4dc]">株式会社シゴトク</a>
  </p>
</section>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const success = document.getElementById('waitlist-success');
  const error = document.getElementById('waitlist-error');
  const submit = document.getElementById('waitlist-submit') as HTMLButtonElement | null;
  const formspreeId = form?.dataset.formspreeId ?? '';

  function showError(msg: string) {
    if (!error) return;
    error.textContent = msg;
    error.classList.remove('hidden');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!formspreeId) return showError('フォームが未設定です。メールでご連絡ください。');
    error?.classList.add('hidden');
    if (submit) {
      submit.disabled = true;
      submit.textContent = '送信中...';
    }
    try {
      const res = await fetch(`https://formspree.io/f/${formspreeId}`, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      if (res.ok) {
        form.classList.add('hidden');
        success?.classList.remove('hidden');
        form.reset();
      } else {
        showError('送信に失敗しました。時間をおいて再度お試しください。');
      }
    } catch {
      showError('送信に失敗しました。時間をおいて再度お試しください。');
    } finally {
      if (submit) {
        submit.disabled = false;
        submit.textContent = '先行利用を申し込む';
      }
    }
  });
</script>
