---
const beats = [
  {
    titleHtml: '手元の<span class="wrapit-em">写真と文章</span>から始める',
    body: '職場の写真、募集要項、お知らせの文面。いまある素材をまとめるだけ。ゼロから動画を企画する時間を減らし、伝える内容に集中できます。',
  },
  {
    titleHtml: '会社の<span class="wrapit-em">決まり</span>を、先に決めておく',
    body: 'ロゴ・色・フォント・言い回し・使ってはいけない表現を一度登録。毎回デザインを悩まず、誰が作っても同じトーンに揃います。',
  },
  {
    titleHtml: '<span class="wrapit-em">AI</span> のたたき台を、人が確認して承認',
    body: '台本づくりは AI が支援。内容と事実の確認、承認は人が行います。承認前に公開されることはありません。',
  },
];
---

<section id="story" class="wrapit-section bg-wrap-bg">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-wrap-accent" data-reveal>Scroll</p>
    <h2 class="wrapit-h2 mt-3 font-bold text-wrap-text" data-reveal data-reveal-delay="1" data-jp-heading>
      動画づくりが、だんだん<span class="wrapit-em">楽</span>になる。
    </h2>
    <p class="wrapit-lead mt-4 text-wrap-muted" data-reveal data-reveal-delay="2" data-jp-wrap>
      下に進むほど、WrapIt がどう助けるかが見えてきます。
    </p>
  </div>

  <ol class="mx-auto mt-14 max-w-2xl space-y-16 px-6">
    {beats.map((b, i) => (
      <li class="relative border-l-2 border-wrap-highlight/40 pl-8" data-reveal data-reveal-delay={(i % 3) + 1}>
        <span
          class="absolute -left-[9px] top-0 flex h-4 w-4 items-center justify-center rounded-full bg-wrap-highlight ring-4 ring-wrap-bg"
          aria-hidden="true"
        ></span>
        <h3 class="wrapit-h3 font-bold text-wrap-text" data-jp-heading set:html={b.titleHtml} />
        <p class="wrapit-body mt-2 text-wrap-muted" data-jp-wrap>{b.body}</p>
      </li>
    ))}
  </ol>
</section>
