---
import Icon from './Icon.astro';
import { problems } from '../data/content';
---

<section class="border-b border-slate-100 bg-white px-4 py-20 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-4xl">
    <div class="mb-12 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-slate-400">Problem → Solution</p>
      <h2 class="text-3xl font-extrabold text-slate-900 sm:text-4xl">起業家が費やす時間の<br class="hidden sm:block" />ほとんどは、本業ではない。</h2>
      <p class="mx-auto mt-4 max-w-xl text-slate-500">手続き・調査・書類作成。これらを半分にすることが、私たちのミッションです。</p>
    </div>
    <div class="space-y-4">
      {problems.map((p) => (
        <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-slate-200 sm:grid-cols-2">
          <div class="flex items-start gap-4 bg-slate-50 px-6 py-5">
            <div class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-200">
              <span class="text-xs font-bold text-slate-500">✕</span>
            </div>
            <p class="text-sm leading-relaxed text-slate-600">{p.before}</p>
          </div>
          <div class="flex items-start gap-4 border-t border-slate-200 bg-white px-6 py-5 sm:border-l sm:border-t-0">
            <div class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary-100">
              <Icon name="check-circle" class="h-3.5 w-3.5 text-primary-600" />
            </div>
            <p class="text-sm font-medium leading-relaxed text-slate-800">{p.after}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
