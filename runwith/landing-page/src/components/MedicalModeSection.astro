---
import Icon from './Icon.astro';

const medicalFeatures = [
  { label: '薬機法ナビゲーター', desc: 'クラス分類から承認申請まで' },
  { label: '臨床研究ロードマップ', desc: '倫理審査からFIH試験まで' },
  { label: 'PMDA対応ガイド', desc: '事前面談の準備を完全サポート' },
  { label: '医療機器届出管理', desc: '保健所・PMDA・認証機関' },
  { label: 'KOLマッチング', desc: '研究者・医師との連携構築' },
  { label: '治験管理', desc: '治験計画届・CRO選定' },
];

const stats = [
  { num: '2026', label: '年 日本の医療AI市場規模（予測：約3,000億円）' },
  { num: '医療機器', label: 'スタートアップのPMDA承認取得まで平均3〜7年' },
  { num: '薬機法', label: '違反時は最大3年以下の懲役または300万円以下の罰金' },
];
---

<section class="bg-slate-950 px-4 py-20 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-5xl">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-1.5 text-sm font-semibold text-emerald-400">
          <Icon name="stethoscope" class="h-4 w-4" />
          Medical Mode
        </div>
        <div class="headline-fit-wrap">
        <h2 class="text-3xl font-extrabold leading-tight text-white sm:text-4xl" data-headline-fit>医療スタートアップに、専用の武器を。</h2>
        </div>
        <p class="mt-5 text-base leading-relaxed text-slate-400">薬機法・PMDAの壁は高い。でも、正しい知識と手順があれば必ず越えられる。医療機器・デジタルヘルス・医薬品・バイオテックに特化した専門コンテンツを追加搭載。</p>
        <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {medicalFeatures.map((item) => (
            <div class="flex items-start gap-3 rounded-xl border border-emerald-500/15 bg-emerald-500/5 p-4">
              <Icon name="check-circle" class="mt-0.5 h-4 w-4 shrink-0 text-emerald-400" />
              <div>
                <p class="text-sm font-semibold text-white">{item.label}</p>
                <p class="text-xs text-slate-500">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-6">
          <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-1.5 text-sm font-semibold text-emerald-400">Growth/Proプランに +¥3,000/月 で追加可能</span>
        </div>
      </div>
      <div class="space-y-3">
        {stats.map((s) => (
          <div class="rounded-2xl border border-white/8 bg-white/5 p-6">
            <p class="text-2xl font-extrabold text-white">{s.num}</p>
            <p class="mt-1 text-sm text-slate-400">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
