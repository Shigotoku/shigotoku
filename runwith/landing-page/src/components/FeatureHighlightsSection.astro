---
import { features } from '../data/content';
---

<section id="features" class="border-b border-slate-100 bg-white px-4 py-20 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="mb-14 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-slate-400">Core Features</p>
      <h2 class="text-3xl font-extrabold text-slate-900 sm:text-4xl">15のツールを、ひとつのアカウントで。</h2>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <div class="group rounded-2xl border border-slate-200/60 bg-white p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md">
          <div class="mb-4 flex items-start justify-between">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-100 text-sm font-bold text-slate-700">{f.title[0]}</div>
            <span class={`rounded-full px-2.5 py-0.5 text-[11px] font-semibold ${f.badgeColor}`}>{f.badge}</span>
          </div>
          <h3 class="text-base font-bold text-slate-900">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-500">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
