---
import Icon from './Icon.astro';
import { phases } from '../data/content';
import { appPath } from '../lib/urls';

const loginUrl = appPath('/login');
---

<section class="bg-slate-950 px-4 py-20 sm:px-6 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 text-center headline-fit-wrap">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-slate-500">Your Journey</p>
      <h2 class="text-3xl font-extrabold text-white sm:text-4xl" data-headline-fit>あなたの今のフェーズを選んでください。</h2>
      <p class="mt-3 text-slate-400">フェーズに応じたツールと情報をご用意しています</p>
    </div>

    <div class="mb-8 flex flex-wrap justify-center gap-2" id="phase-tabs">
      {phases.map((p, i) => (
        <button
          type="button"
          data-phase-index={i}
          class={`phase-tab rounded-full px-4 py-2 text-sm font-semibold transition-all ${i === 0 ? 'bg-white text-slate-900 shadow-lg' : 'border border-white/10 text-slate-400 hover:border-white/20 hover:text-slate-200'}`}
        >
          <span class="mr-1.5 text-xs opacity-60">{p.num}</span>
          {p.label}
        </button>
      ))}
    </div>

    <div class="overflow-hidden rounded-3xl border border-white/10 bg-white/5 backdrop-blur-sm">
      {phases.map((phase, i) => (
        <div data-phase-panel={i} class={`phase-panel grid grid-cols-1 lg:grid-cols-2 ${i === 0 ? '' : 'hidden'}`}>
          <div class="border-b border-white/10 p-8 lg:border-b-0 lg:border-r sm:p-10">
            <div class={`mb-4 inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold ${phase.bg} ${phase.accent}`}>
              <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
              {phase.label}
            </div>
            <h3 class="whitespace-pre-line text-3xl font-extrabold leading-tight text-white sm:text-4xl">{phase.headline}</h3>
            <p class="mt-5 text-base leading-relaxed text-slate-400">{phase.description}</p>
            <div class="mt-6 flex flex-wrap gap-2">
              {phase.tags.map((tag) => (
                <span class="rounded-md border border-white/10 px-2.5 py-1 text-xs text-slate-400">{tag}</span>
              ))}
            </div>
            <a href={loginUrl} class="group mt-8 inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-bold text-slate-900 transition-all hover:bg-slate-100">
              このフェーズで登録する
              <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
            </a>
          </div>
          <div class="p-8 sm:p-10">
            <p class="mb-5 text-xs font-semibold uppercase tracking-widest text-slate-500">利用できるツール</p>
            <div class="space-y-3">
              {phase.tools.map((tool) => (
                <div class="flex items-center gap-4 rounded-xl border border-white/8 bg-white/5 p-4">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white/10">
                    <div class="h-5 w-5 rounded bg-white/30"></div>
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-semibold text-white">{tool.label}</p>
                    <p class="text-xs text-slate-400">{tool.desc}</p>
                  </div>
                  <span class={`shrink-0 rounded-full px-2.5 py-0.5 text-[10px] font-semibold ${tool.free ? 'bg-emerald-900 text-emerald-300' : 'bg-slate-800 text-slate-400'}`}>
                    {tool.free ? '無料' : '有料'}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.phase-tab');
  const panels = document.querySelectorAll<HTMLElement>('.phase-panel');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const index = tab.dataset.phaseIndex;
      tabs.forEach((t) => {
        t.classList.remove('bg-white', 'text-slate-900', 'shadow-lg');
        t.classList.add('border', 'border-white/10', 'text-slate-400');
      });
      tab.classList.add('bg-white', 'text-slate-900', 'shadow-lg');
      tab.classList.remove('border', 'border-white/10', 'text-slate-400');

      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.phasePanel !== index);
      });
    });
  });
</script>
