---
import { caseStudies } from '../data/content';
---

<section id="cases" class="border-b border-slate-100 bg-slate-50 px-4 py-20 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-slate-400">Case Studies</p>
      <h2 class="text-3xl font-extrabold text-slate-900 sm:text-4xl">導入事例</h2>
      <p class="mx-auto mt-4 max-w-2xl text-slate-500">創業支援・補助金活用・医療スタートアップの現場で、ランウィズがどう使われているか。</p>
    </div>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      {caseStudies.map((item) => (
        <article class="flex flex-col rounded-2xl border border-slate-200/60 bg-white p-7 shadow-sm">
          <span class={`mb-4 inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold ${item.tagColor}`}>{item.tag}</span>
          <h3 class="text-lg font-bold text-slate-900">{item.title}</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{item.summary}</p>
          <dl class="mt-6 space-y-3 border-t border-slate-100 pt-5">
            {item.metrics.map((metric) => (
              <div class="flex items-start justify-between gap-4">
                <dt class="text-xs text-slate-400">{metric.label}</dt>
                <dd class="text-right text-sm font-bold text-slate-900">{metric.value}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>
  </div>
</section>
