---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { pricingPlans, faqs, comparisonRows } from '../data/content';
import { appPath } from '../lib/urls';

const loginUrl = appPath('/login');
const medicalFeatures = [
  '薬機法ナビゲーター',
  '臨床研究ロードマップ',
  'PMDA対応ガイド',
  '医療機器届出管理',
  'KOLマッチング',
  '治験管理ツール',
];
---

<Layout title="料金プラン | ランウィズ (Runwith)" description="ランウィズの料金プラン。会社設立ナビは完全無料。成長に合わせてアップグレード。">
  <div class="bg-white">
    <section class="border-b border-slate-100 bg-slate-950 px-4 py-20 text-center sm:px-6 sm:py-24 headline-fit-wrap">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-slate-500">Pricing</p>
      <h1 class="text-4xl font-extrabold text-white sm:text-5xl" data-headline-fit>シンプルな料金プラン</h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-slate-400">会社設立ナビは完全無料。成長に合わせてアップグレード。いつでもキャンセルできます。</p>
      <p class="mt-4 text-sm text-slate-500">クレジットカード不要で今日から始められます</p>
    </section>

    <section class="px-4 py-16 sm:px-6 sm:py-20">
      <div class="mx-auto max-w-5xl">
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
          {pricingPlans.map((plan) => (
            <div class={`relative flex flex-col rounded-2xl border bg-white p-7 shadow-sm transition-all hover:shadow-md ${plan.border}`}>
              <div class="mb-5 flex items-start justify-between">
                <div>
                  <h2 class="text-xl font-bold text-slate-900">{plan.name}</h2>
                  <p class="mt-1 text-xs text-slate-500">{plan.desc}</p>
                </div>
                <span class={`ml-2 shrink-0 rounded-full px-2.5 py-0.5 text-[11px] font-semibold ${plan.tagColor}`}>{plan.tag}</span>
              </div>
              <div class="mb-6">
                <div class="flex items-end gap-1">
                  <span class="text-4xl font-extrabold text-slate-900">¥{plan.price.toLocaleString()}</span>
                  <span class="mb-1 text-sm text-slate-400">/月</span>
                </div>
                {plan.price > 0 && (
                  <p class="mt-0.5 text-xs text-slate-400">年払い時 ¥{Math.round(plan.price * 10).toLocaleString()}/月（2ヶ月分お得）</p>
                )}
              </div>
              <ul class="mb-8 flex-1 space-y-2">
                {plan.features.map((f) => (
                  <li class="flex items-start gap-2">
                    {f.included ? (
                      <Icon name="check-circle" class="mt-0.5 h-4 w-4 shrink-0 text-primary-500" />
                    ) : (
                      <Icon name="x" class="mt-0.5 h-4 w-4 shrink-0 text-slate-200" />
                    )}
                    <span class={`text-sm ${f.included ? 'text-slate-700' : 'text-slate-400'}`}>{f.label}</span>
                  </li>
                ))}
              </ul>
              <a href={loginUrl} class={`flex w-full items-center justify-center gap-2 rounded-xl py-3.5 text-sm font-bold transition-all ${plan.ctaStyle}`}>
                {plan.ctaLabel}
                <Icon name="arrow-right" class="h-4 w-4" />
              </a>
            </div>
          ))}
        </div>

        <div class="mt-6 overflow-hidden rounded-2xl border border-emerald-200 bg-emerald-50">
          <div class="grid grid-cols-1 sm:grid-cols-2">
            <div class="border-b border-emerald-100 p-6 sm:border-b-0 sm:border-r">
              <div class="mb-3 flex items-center gap-2.5">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-100">
                  <Icon name="stethoscope" class="h-5 w-5 text-emerald-700" />
                </div>
                <div>
                  <h3 class="font-bold text-slate-900">医療モード アドオン</h3>
                  <p class="text-xs text-slate-500">Growth / Proプランに追加可能</p>
                </div>
              </div>
              <div class="mt-2">
                <span class="text-3xl font-extrabold text-slate-900">+¥3,000</span>
                <span class="text-sm text-slate-500">/月</span>
              </div>
              <p class="mt-3 text-sm text-slate-600">医療機器・デジタルヘルス・バイオテック・遠隔医療に特化した専門機能を追加搭載。</p>
            </div>
            <div class="p-6">
              <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">含まれる機能</p>
              <div class="grid grid-cols-2 gap-2">
                {medicalFeatures.map((f) => (
                  <div class="flex items-center gap-1.5 text-sm text-emerald-800">
                    <Icon name="check" class="h-3.5 w-3.5 shrink-0 text-emerald-600" />
                    {f}
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-slate-100 bg-slate-50 px-4 py-16 sm:px-6">
      <div class="mx-auto max-w-4xl">
        <h2 class="mb-8 text-center text-2xl font-bold text-slate-900">プラン別機能比較</h2>
        <div class="overflow-x-auto -mx-4 px-4 sm:mx-0 sm:px-0 rounded-2xl border border-slate-200 bg-white shadow-sm">
          <table class="min-w-[520px] w-full">
            <thead>
              <tr class="border-b border-slate-100">
                <th class="px-5 py-4 text-left text-sm font-semibold text-slate-700">機能</th>
                {['Free', 'Growth', 'Pro'].map((p) => (
                  <th class="px-4 py-4 text-center text-sm font-bold text-slate-900">{p}</th>
                ))}
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {comparisonRows.map((row) => (
                <tr class="hover:bg-slate-50">
                  <td class="px-5 py-3 text-sm text-slate-700">{row.label}</td>
                  {[row.free, row.growth, row.pro].map((val) => (
                    <td class="px-4 py-3 text-center">
                      {val ? (
                        <Icon name="check-circle" class="mx-auto h-4 w-4 text-primary-500" />
                      ) : (
                        <span class="mx-auto block h-4 w-4 rounded-full bg-slate-200"></span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="border-t border-slate-100 bg-white px-4 py-16 sm:px-6">
      <div class="mx-auto max-w-2xl">
        <h2 class="mb-8 text-center text-2xl font-bold text-slate-900">よくある質問</h2>
        <div class="space-y-2">
          {faqs.map((faq) => (
            <details class="overflow-hidden rounded-xl border border-slate-200 group">
              <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 text-left marker:content-none">
                <span class="text-sm font-semibold text-slate-900">{faq.q}</span>
                <span class="ml-3 shrink-0 rounded-full bg-slate-100 p-1 transition-transform group-open:rotate-45">
                  <svg class="h-3.5 w-3.5 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                </span>
              </summary>
              <div class="border-t border-slate-100 px-5 py-4">
                <p class="text-sm leading-relaxed text-slate-600">{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-slate-950 px-4 py-20 text-center sm:px-6 headline-fit-wrap">
      <h2 class="text-3xl font-extrabold text-white sm:text-4xl" data-headline-fit>まずは無料で始めてみる。</h2>
      <p class="mt-3 text-slate-400">会社設立ナビは完全無料。クレジットカード不要。</p>
      <a href={loginUrl} class="group mt-8 inline-flex items-center gap-2 rounded-xl bg-white px-8 py-3.5 text-sm font-bold text-slate-900 transition-all hover:bg-slate-100">
        無料アカウントを作成する
        <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
      </a>
    </section>
  </div>
</Layout>
