# コピーして .env を作る（.env は git に入れない）

# 認証: 既定は「鍵なし」（gcloud の Application Default Credentials + サービスアカウントなりすまし）。
# 鍵ファイルが作れる環境だけ、下の行を有効にする（組織ポリシーで禁止されている場合は空のまま）。
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# Search Console のプロパティ（ドメイン型は sc-domain:ドメイン）
GSC_SITE_URL=sc-domain:example.com

# GA4 のプロパティID（数字のみ。GA4 管理 > プロパティ設定 に表示）
GA4_PROPERTY_ID=

# AI(任意): ollama | openai-compat | anthropic | gemini
AI_PROVIDER=none
# AI_MODEL=
# AI_BASE_URL=
# AI_API_KEY=
