---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
	title: string;
	description?: string;
	/** トップ以外ではヒーロー画像の preload を省略 */
	preloadHero?: boolean;
}

const {
	title,
	description = 'BuzzIt（バジット）— 美容室・飲食店・クリニック向け。SNS・LINE・Googleマップ・ホットペッパーをまとめて、毎朝5分の運用へ。',
	preloadHero = true,
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<meta name="application-name" content="BuzzIt（バジット）" />
		<meta name="apple-mobile-web-app-title" content="BuzzIt" />
		<meta name="theme-color" content="#f5f4f0" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="manifest" href={`${base}site.webmanifest`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
		{preloadHero && (
			<link rel="preload" as="image" href={`${base}images/hero-collage.webp`} type="image/webp" fetchpriority="high" />
		)}
		<link rel="preconnect" href="https://images.unsplash.com" />
		<Seo title={title} description={description} />
		<Analytics />
		<title>{title}</title>
	</head>
	<body class="antialiased selection:bg-violet-200 selection:text-violet-900">
		<slot />

		<script>
			const setupAnimations = () => {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
							}
						});
					},
					{ threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
				);

				document.querySelectorAll('.animate-on-scroll').forEach((el) => {
					observer.observe(el);
				});
			};

			setupAnimations();
			document.addEventListener('astro:page-load', setupAnimations);

			const fitHeadlines = () => {
				const mobile = window.matchMedia('(max-width: 767px)').matches;
				document.querySelectorAll('[data-headline-fit]').forEach((el) => {
					const node = el;
					node.style.fontSize = '';
					node.style.whiteSpace = '';
					if (!mobile) return;

					const wrap = node.closest('.headline-fit-wrap');
					const maxWidth = wrap?.clientWidth ?? node.parentElement?.clientWidth ?? window.innerWidth;
					const maxPx = Number(node.dataset.headlineMax) || 30;
					const minPx = Number(node.dataset.headlineMin) || 13;

					node.style.whiteSpace = 'nowrap';
					let low = minPx;
					let high = maxPx;
					while (high - low > 0.25) {
						const mid = (low + high) / 2;
						node.style.fontSize = `${mid}px`;
						if (node.scrollWidth > maxWidth) high = mid;
						else low = mid;
					}
					node.style.fontSize = `${low}px`;
				});
			};

			let headlineFitReady = false;
			const initHeadlineFit = () => {
				fitHeadlines();
				if (headlineFitReady) return;
				headlineFitReady = true;
				window.addEventListener('resize', fitHeadlines);
				document.fonts?.ready.then(fitHeadlines);
				const ro = new ResizeObserver(() => fitHeadlines());
				document.querySelectorAll('.headline-fit-wrap').forEach((el) => ro.observe(el));
			};

			initHeadlineFit();
			document.addEventListener('astro:page-load', initHeadlineFit);

			const JP_WRAP_SELECTOR =
				'[data-jp-wrap], main p, main li, footer p, footer li';

			const enhanceJpWrap = (root = document) => {
				root.querySelectorAll(JP_WRAP_SELECTOR).forEach((el) => {
					const node = el;
					if (node.dataset.jpWrapDone || node.closest('[data-jp-wrap-off], [data-headline-fit]')) return;
					if (!/[ぁ-んァ-ヶ一-龠]/.test(node.textContent ?? '')) return;

					const walker = document.createTreeWalker(node, NodeFilter.SHOW_TEXT, {
						acceptNode(textNode) {
							const tag = textNode.parentElement?.tagName;
							if (tag === 'SCRIPT' || tag === 'STYLE') return NodeFilter.FILTER_REJECT;
							return NodeFilter.FILTER_ACCEPT;
						},
					});

					const textNodes = [];
					let current = walker.nextNode();
					while (current) {
						textNodes.push(current);
						current = walker.nextNode();
					}

					textNodes.forEach((textNode) => {
						const text = textNode.textContent ?? '';
						if (!/[、。！？；：]/.test(text)) return;

						const frag = document.createDocumentFragment();
						let last = 0;
						const re = /[、。！？；：]/g;
						let match;
						while ((match = re.exec(text)) !== null) {
							const end = match.index + match[0].length;
							frag.appendChild(document.createTextNode(text.slice(last, end)));
							frag.appendChild(document.createElement('wbr'));
							last = end;
						}
						if (last >= text.length) {
							textNode.parentNode?.replaceChild(frag, textNode);
							return;
						}
						frag.appendChild(document.createTextNode(text.slice(last)));
						textNode.parentNode?.replaceChild(frag, textNode);
					});

					node.dataset.jpWrapDone = 'true';
				});
			};

			enhanceJpWrap();
			document.addEventListener('astro:page-load', () => enhanceJpWrap());
		</script>
	</body>
</html>
