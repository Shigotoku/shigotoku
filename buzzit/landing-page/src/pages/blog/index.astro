---
import Layout from '../../layouts/Layout.astro';
import Seo from '../../components/Seo.astro';

const posts = [
  {
    slug: 'line-cost-2026',
    title: '2026年秋 LINE料金改定 — 美容室が今すぐやるべき3つの対策',
    date: '2026-05-20',
    excerpt: '配信コスト最大1.91倍。セグメント配信とBuzzItでのコスト試算で、Lステップ依存から脱却する方法。',
  },
  {
    slug: 'vs-lstep',
    title: 'Lステップ代替 — BuzzIt Growth OS で何ができるか',
    date: '2026-05-18',
    excerpt: '¥21,780のLステップ機能を、SNS・MEO・HPBトラッキング込みの¥24,800に内包する理由。',
  },
  {
    slug: 'salon-sns-guide',
    title: '美容室SNS運用の教科書 — 毎朝5分ルーティン',
    date: '2026-05-15',
    excerpt: 'マジック・クリエイターとボイスドラフトで、ネタ出しから予約まで一気通貫。',
  },
];
---

<Layout>
  <Seo
    title="ブログ | BuzzIt"
    description="LINE料金改定対策・美容室SNS運用・Lステップ代替など、店舗マーケの実践記事"
  />
  <main class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-900">BuzzIt ブログ</h1>
    <p class="mt-3 text-neutral-600">店舗のSNS・LINE・MEO運用に役立つ記事</p>
    <ul class="mt-12 space-y-8">
      {posts.map((post) => (
        <li class="border-b border-neutral-200 pb-8">
          <a href={`/buzzit/blog/${post.slug}/`} class="group block">
            <time class="text-xs text-neutral-500">{post.date}</time>
            <h2 class="mt-1 text-xl font-semibold text-neutral-900 group-hover:underline">{post.title}</h2>
            <p class="mt-2 text-sm text-neutral-600">{post.excerpt}</p>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>
