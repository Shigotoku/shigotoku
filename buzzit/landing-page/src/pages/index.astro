---
import Layout from '../layouts/Layout.astro';
import { appPath, CORPORATE_URL } from '../lib/urls';

const loginUrl = appPath('/login');
---

<Layout title="BuzzPilot | SNSを自動化し、組織を動かし、売上を作る経営OS">
	<main class="relative min-h-screen overflow-hidden bg-slate-50">
		<!-- Soft Background Elements -->
		<div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] bg-indigo-100/60 blur-[150px] rounded-full pointer-events-none"></div>
		<div class="absolute bottom-[20%] right-[-10%] w-[60%] h-[60%] bg-sky-100/50 blur-[150px] rounded-full pointer-events-none"></div>
		
		<!-- Navigation -->
		<header class="fixed top-0 w-full z-50 bg-white/70 backdrop-blur-xl border-b border-slate-200/50 transition-all animate-on-scroll fade-in">
			<div class="max-w-[1400px] mx-auto px-6 md:px-12 h-20 flex items-center justify-between">
				<div class="flex items-center gap-3 group cursor-pointer">
					<div class="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center font-bold text-xl text-white shadow-lg shadow-indigo-200 group-hover:scale-105 transition-transform">B</div>
					<span class="text-2xl font-bold font-['Outfit'] tracking-tight text-slate-800">BuzzPilot</span>
				</div>
				<nav class="hidden md:flex items-center gap-10 text-sm font-medium text-slate-600">
					<a href="#features" class="hover:text-indigo-600 transition-colors">機能</a>
					<a href="#solution" class="hover:text-indigo-600 transition-colors">解決策</a>
					<a href="#pricing" class="hover:text-indigo-600 transition-colors">料金プラン</a>
				</nav>
				<div class="flex items-center gap-5">
					<a href={loginUrl} class="text-sm font-medium text-slate-600 hover:text-indigo-600 transition-colors hidden sm:block">ログイン</a>
					<a href={loginUrl} class="px-7 py-2.5 rounded-full bg-slate-900 text-white font-semibold text-sm hover:bg-indigo-600 transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5">無料診断を始める</a>
				</div>
			</div>
		</header>

		<!-- Hero Section -->
		<section class="pt-32 pb-20 px-6 md:px-12 max-w-[1500px] mx-auto relative z-10 min-h-[95vh] flex items-center">
			<div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20 w-full">
				<!-- Text Column -->
				<div class="flex-1 text-left relative w-full">
					<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-slate-200 text-indigo-600 text-sm font-bold tracking-wide mb-8 shadow-sm animate-on-scroll slide-up">
						<span class="relative flex h-2 w-2">
						  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
						  <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
						</span>
						SNS運用の新常識、はじまる。
					</div>
					<h1 class="text-6xl md:text-8xl lg:text-[100px] font-bold font-['Outfit'] tracking-tighter mb-8 leading-[1.05] text-slate-900 animate-on-scroll slide-up delay-100">
						「SNSツール」<br/>ではなく、<br/>
						<span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-sky-500 inline-block pb-2">
							売上を作る経営OS。
						</span>
					</h1>
					<p class="text-xl md:text-2xl text-slate-500 max-w-2xl mb-12 leading-relaxed animate-on-scroll slide-up delay-200">
						毎朝5分のルーティンで運用完了。担当者の孤独をなくし、全社員を巻き込む。BtoC店舗ビジネスのための次世代SaaS。
					</p>
					<div class="flex flex-col sm:flex-row gap-5 w-full sm:w-auto animate-on-scroll slide-up delay-300">
						<a href={loginUrl} class="px-12 py-5 rounded-full bg-indigo-600 text-white font-bold text-lg hover:bg-indigo-700 hover:shadow-2xl hover:shadow-indigo-300 transition-all hover:-translate-y-1 text-center">
							無料で試してみる
						</a>
						<a href="#" class="px-12 py-5 rounded-full bg-white border border-slate-200 text-slate-700 font-bold text-lg hover:bg-slate-50 transition-all hover:-translate-y-1 text-center flex items-center justify-center gap-2">
							<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
							デモを見る
						</a>
					</div>
				</div>
				<!-- Image Column -->
				<div class="flex-1 relative w-full aspect-[4/3] lg:aspect-square max-w-3xl animate-on-scroll slide-left delay-200">
					<div class="absolute inset-0 bg-gradient-to-tr from-indigo-100 to-sky-100 rounded-[40px] transform rotate-3 scale-105 transition-transform duration-1000 hover:rotate-6"></div>
					<img 
						src="/images/clean_smartphone_mockup_1779181630641.png" 
						alt="Trendy young woman using smartphone" 
						class="relative z-10 w-full h-full object-cover rounded-[40px] shadow-2xl shadow-slate-300/60"
					/>
					<!-- Floating UI Element 1 -->
					<div class="absolute -bottom-8 -left-12 z-20 bg-white/90 backdrop-blur-xl border border-slate-100 p-6 rounded-3xl shadow-2xl shadow-slate-200/80 animate-on-scroll slide-up delay-300">
						<div class="flex items-center gap-5 mb-2">
							<div class="w-14 h-14 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600">
								<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
							</div>
							<div>
								<div class="text-slate-500 text-sm font-medium mb-1">先週比売上貢献</div>
								<div class="text-slate-900 font-extrabold text-3xl">+¥342,000</div>
							</div>
						</div>
					</div>
					<!-- Floating UI Element 2 -->
					<div class="absolute top-12 -right-8 z-20 bg-white/90 backdrop-blur-xl border border-slate-100 p-5 rounded-3xl shadow-2xl shadow-slate-200/80 animate-on-scroll slide-left delay-300">
						<div class="flex items-center gap-3">
							<div class="flex -space-x-2">
								<div class="w-10 h-10 rounded-full bg-slate-200 border-2 border-white overflow-hidden"><img src="https://api.dicebear.com/7.x/avataaars/svg?seed=A" alt="user"/></div>
								<div class="w-10 h-10 rounded-full bg-slate-200 border-2 border-white overflow-hidden"><img src="https://api.dicebear.com/7.x/avataaars/svg?seed=B" alt="user"/></div>
								<div class="w-10 h-10 rounded-full bg-slate-200 border-2 border-white overflow-hidden"><img src="https://api.dicebear.com/7.x/avataaars/svg?seed=C" alt="user"/></div>
							</div>
							<div class="text-sm font-bold text-slate-700">チームで承認</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Bento Box Features -->
		<section id="features" class="py-32 relative z-10">
			<div class="max-w-[1400px] mx-auto px-6 md:px-12">
				<div class="mb-20 text-center animate-on-scroll slide-up">
					<h2 class="text-5xl md:text-6xl font-bold font-['Outfit'] tracking-tight mb-6 text-slate-900">すべてを繋ぎ、<br/>美しく自動化する。</h2>
					<p class="text-slate-500 text-xl max-w-3xl mx-auto">今までバラバラだったSNS運用、企画出し、売上管理。<br/>BuzzPilotがそれらを一つにまとめ、あなたの代わりに自律的に運用します。</p>
				</div>
				
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<!-- Bento 1: Image Left Card -->
					<div class="col-span-1 md:col-span-2 rounded-[40px] bg-white border border-slate-100 overflow-hidden shadow-xl shadow-slate-200/50 relative group animate-on-scroll slide-right">
						<div class="absolute inset-0">
							<img src="/images/clean_team_collaboration_1779181646382.png" alt="Team Collaboration" class="w-full h-full object-cover transition-transform duration-[1.5s] group-hover:scale-105" />
							<div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/20 to-transparent"></div>
						</div>
						<div class="relative z-10 p-12 h-full flex flex-col justify-end min-h-[500px]">
							<div class="w-16 h-16 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center text-white mb-6 border border-white/30 transform transition-transform group-hover:-translate-y-2">
								<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
							</div>
							<h3 class="text-4xl font-bold text-white mb-4">全社を巻き込む仕組み</h3>
							<p class="text-slate-200 text-lg max-w-lg leading-relaxed">店舗のリアルな熱狂をそのままSNSへ。Slack連携で摩擦ゼロで社員のアイデアを吸い上げ、担当者の孤独をなくします。</p>
						</div>
					</div>

					<!-- Bento 2: Text Card -->
					<div class="col-span-1 rounded-[40px] bg-white border border-slate-100 shadow-xl shadow-slate-200/50 p-12 flex flex-col animate-on-scroll slide-left delay-100 group">
						<div class="w-16 h-16 rounded-2xl bg-indigo-50 flex items-center justify-center text-indigo-600 mb-8 transform transition-transform group-hover:scale-110">
							<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
						</div>
						<h3 class="text-3xl font-bold text-slate-900 mb-4">思考ゼロのUX</h3>
						<p class="text-slate-500 text-lg flex-1 leading-relaxed">ユーザーはAIが提示した「今日やること（台本を読む・承認する）」だけを実行。何を投稿すべきか悩む時間はもう終わりです。</p>
					</div>

					<!-- Bento 3: Text Card -->
					<div class="col-span-1 rounded-[40px] bg-white border border-slate-100 shadow-xl shadow-slate-200/50 p-12 flex flex-col animate-on-scroll slide-right delay-100 group">
						<div class="w-16 h-16 rounded-2xl bg-sky-50 flex items-center justify-center text-sky-600 mb-8 transform transition-transform group-hover:scale-110">
							<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
						</div>
						<h3 class="text-3xl font-bold text-slate-900 mb-4">一気通貫の自動化</h3>
						<p class="text-slate-500 text-lg flex-1 leading-relaxed">1本のショート動画から、各SNS向けに最適化されたテキストやカルーセルを自動生成。Auto Modeなら完全自動運用も可能。</p>
					</div>

					<!-- Bento 4: Image Card -->
					<div class="col-span-1 md:col-span-2 rounded-[40px] bg-white border border-slate-100 overflow-hidden shadow-xl shadow-slate-200/50 relative group animate-on-scroll slide-left delay-200">
						<div class="absolute inset-0">
							<img src="/images/clean_salon_interior_1779181614631.png" alt="Clean Salon Interior" class="w-full h-full object-cover transition-transform duration-[1.5s] group-hover:scale-105" />
							<div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/20 to-transparent"></div>
						</div>
						<div class="relative z-10 p-12 h-full flex flex-col justify-end min-h-[500px]">
							<div class="w-16 h-16 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center text-white mb-6 border border-white/30 transform transition-transform group-hover:-translate-y-2">
								<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
							</div>
							<h3 class="text-4xl font-bold text-white mb-4">深い売上トラッキング</h3>
							<p class="text-slate-200 text-lg max-w-lg leading-relaxed">「いいね」の数ではなく、実際の来店・売上にどう繋がったかを可視化。リアルな空間とデジタルの成果を直結させます。</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Dashboard Interactive Mockup -->
		<section class="py-32 relative z-10 bg-white border-y border-slate-200">
			<div class="max-w-[1400px] mx-auto px-6 md:px-12">
				<div class="text-center animate-on-scroll slide-up mb-16">
					<h2 class="text-5xl md:text-6xl font-bold font-['Outfit'] mb-6 text-slate-900">美しい経営コクピット</h2>
					<p class="text-slate-500 text-xl">複雑なグラフは不要。あなたが今日やるべきことは、AIがすべて提案します。</p>
				</div>
				
				<div class="rounded-[40px] border border-slate-200 bg-slate-50/50 backdrop-blur-xl overflow-hidden shadow-2xl shadow-slate-200/60 relative max-w-6xl mx-auto animate-on-scroll slide-up delay-200">
					<div class="h-16 bg-white border-b border-slate-200 flex items-center px-6 gap-3">
						<div class="w-3.5 h-3.5 rounded-full bg-slate-300"></div>
						<div class="w-3.5 h-3.5 rounded-full bg-slate-300"></div>
						<div class="w-3.5 h-3.5 rounded-full bg-slate-300"></div>
					</div>
					<div class="p-12 grid grid-cols-1 md:grid-cols-3 gap-10 text-left bg-white/50">
						<div class="col-span-2 space-y-10">
							<div class="rounded-[32px] bg-indigo-50 border border-indigo-100 p-10 shadow-sm animate-on-scroll slide-left delay-300 hover:shadow-md transition-shadow">
								<div class="text-indigo-600 text-sm font-bold tracking-widest mb-4 uppercase flex items-center gap-2">
									<span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
									Today's Mission
								</div>
								<h3 class="text-slate-900 font-bold text-3xl mb-3">新作「春カラー」の動画を承認してください</h3>
								<p class="text-slate-500 mb-8 text-xl">AIが3パターンの台本と動画を生成しました。確認後、ワンタップで全SNSへ予約されます。</p>
								<button class="px-8 py-4 rounded-xl bg-indigo-600 text-white font-bold text-lg hover:bg-indigo-700 transition-colors shadow-md hover:shadow-lg hover:-translate-y-0.5">内容を確認・承認する</button>
							</div>
							<div class="flex gap-10">
								<div class="flex-1 rounded-[32px] bg-white border border-slate-200 p-10 shadow-sm animate-on-scroll slide-left delay-300 hover:shadow-md transition-shadow">
									<h3 class="text-slate-500 font-medium mb-3 text-xl">SNS健康スコア</h3>
									<div class="text-7xl font-bold text-slate-900 flex items-baseline gap-4">
										92 <span class="text-xl font-bold text-emerald-500 flex items-center"><svg class="w-6 h-6 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg> +12%</span>
									</div>
								</div>
							</div>
						</div>
						<div class="space-y-8 animate-on-scroll slide-right delay-300">
							<div class="h-full rounded-[32px] bg-white border border-slate-200 p-10 flex flex-col shadow-sm hover:shadow-md transition-shadow">
								<h3 class="text-slate-900 font-bold text-2xl mb-10">売上ファネル</h3>
								<div class="space-y-8 flex-1">
									<div class="animate-on-scroll slide-up delay-100">
										<div class="flex justify-between items-center mb-3"><span class="text-slate-500 text-lg">リーチ</span><span class="text-slate-900 font-bold text-2xl">24,500</span></div>
										<div class="w-full bg-slate-100 rounded-full h-3"><div class="bg-indigo-400 h-3 rounded-full" style="width: 100%"></div></div>
									</div>
									<div class="animate-on-scroll slide-up delay-200">
										<div class="flex justify-between items-center mb-3"><span class="text-slate-500 text-lg">LINE登録</span><span class="text-slate-900 font-bold text-2xl">124</span></div>
										<div class="w-full bg-slate-100 rounded-full h-3"><div class="bg-sky-400 h-3 rounded-full" style="width: 30%"></div></div>
									</div>
									<div class="animate-on-scroll slide-up delay-300">
										<div class="flex justify-between items-center mb-3"><span class="text-slate-500 text-lg">推計売上</span><span class="text-emerald-500 font-bold text-2xl">¥342,000</span></div>
										<div class="w-full bg-slate-100 rounded-full h-3"><div class="bg-emerald-400 h-3 rounded-full" style="width: 15%"></div></div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Massive Footer -->
		<footer class="bg-slate-900 text-slate-400 border-t border-slate-800 pt-32 pb-12 rounded-t-[60px] mt-[-40px] relative z-20">
			<div class="max-w-[1400px] mx-auto px-6 md:px-12">
				<!-- Top CTA -->
				<div class="text-center mb-24 animate-on-scroll slide-up">
					<h2 class="text-4xl md:text-5xl font-bold font-['Outfit'] text-white mb-6">SNS運用を、次のレベルへ。</h2>
					<p class="text-slate-400 text-xl mb-10 max-w-2xl mx-auto">複雑な運用はAIに任せ、あなたは本業に集中するだけ。今すぐ無料診断からはじめましょう。</p>
					<a href={loginUrl} class="inline-block px-10 py-5 rounded-full bg-indigo-500 text-white font-bold text-lg hover:bg-indigo-400 hover:shadow-2xl hover:shadow-indigo-500/20 transition-all hover:-translate-y-1 text-center">
						無料アカウントを作成
					</a>
				</div>

				<div class="grid grid-cols-2 md:grid-cols-5 gap-12 border-t border-slate-800 pt-20 mb-20">
					<div class="col-span-2">
						<div class="flex items-center gap-3 mb-6">
							<div class="w-10 h-10 rounded-xl bg-indigo-500 flex items-center justify-center font-bold text-white text-xl">B</div>
							<span class="font-bold font-['Outfit'] text-white text-2xl">BuzzPilot</span>
						</div>
						<p class="text-slate-400 text-base leading-relaxed max-w-sm mb-8">
							「SNSツール」ではなく、「組織を動かし、売上を作る経営OS」。BtoC店舗ビジネスのための次世代SaaSです。
						</p>
					</div>
					<div>
						<h4 class="text-white font-bold mb-6 font-['Outfit'] text-lg">Product</h4>
						<ul class="space-y-4">
							<li><a href="#" class="hover:text-indigo-400 transition-colors">機能一覧</a></li>
							<li><a href="#" class="hover:text-indigo-400 transition-colors">料金プラン</a></li>
							<li><a href="#" class="hover:text-indigo-400 transition-colors">API統合</a></li>
							<li><a href="#" class="hover:text-indigo-400 transition-colors">Slack連携</a></li>
						</ul>
					</div>
					<div>
						<h4 class="text-white font-bold mb-6 font-['Outfit'] text-lg">Resources</h4>
						<ul class="space-y-4">
							<li><a href="#" class="hover:text-indigo-400 transition-colors">ブログ</a></li>
							<li><a href="#" class="hover:text-indigo-400 transition-colors">導入事例</a></li>
							<li><a href="#" class="hover:text-indigo-400 transition-colors">ヘルプセンター</a></li>
							<li><a href="#" class="hover:text-indigo-400 transition-colors">コミュニティ</a></li>
						</ul>
					</div>
					<div>
						<h4 class="text-white font-bold mb-6 font-['Outfit'] text-lg">Company</h4>
						<ul class="space-y-4">
							<li><a href={CORPORATE_URL} class="hover:text-indigo-400 transition-colors">会社概要</a></li>
							<li><a href="#" class="hover:text-indigo-400 transition-colors">採用情報</a></li>
							<li><a href="#" class="hover:text-indigo-400 transition-colors">プライバシーポリシー</a></li>
							<li><a href="#" class="hover:text-indigo-400 transition-colors">特定商取引法に基づく表記</a></li>
						</ul>
					</div>
				</div>

				<div class="flex flex-col md:flex-row items-center justify-between pt-8 border-t border-slate-800">
					<p>© 2026 BuzzPilot Inc. All rights reserved.</p>
