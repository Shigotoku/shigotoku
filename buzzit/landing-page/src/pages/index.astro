---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import BeforeAfterSection from '../components/BeforeAfterSection.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import InstagramSection from '../components/InstagramSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import PricingSection from '../components/PricingSection.astro';
import CockpitSection from '../components/CockpitSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="BuzzIt（バジット）| SNSを自動化し、組織を動かし、売上を作る経営OS">
  <main class="overflow-x-hidden">
    <Header />
    <HeroSection />
    <BeforeAfterSection />
    <PhotoStrip />
    <InstagramSection />
    <FeaturesSection />
    <PricingSection />
    <CockpitSection />
    <Footer />
  </main>
</Layout>
