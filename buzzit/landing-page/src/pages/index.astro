---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import HowItWorksSection from '../components/HowItWorksSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import BeforeAfterSection from '../components/BeforeAfterSection.astro';
import LineCostSection from '../components/LineCostSection.astro';
import PricingSection from '../components/PricingSection.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="BuzzIt（バジット）| 店舗のSNS・LINE・集客をまとめて自動化">
  <main class="overflow-x-hidden">
    <Header />
    <HeroSection />
    <HowItWorksSection />
    <FeaturesSection />
    <PhotoStrip />
    <BeforeAfterSection />
    <LineCostSection />
    <PricingSection />
    <FaqSection />
    <Footer />
  </main>
</Layout>
