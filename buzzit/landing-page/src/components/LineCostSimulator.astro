---
import { appPath } from '../lib/urls';
import { MESSAGE_PRESETS } from '../lib/lineCostCalc';

const loginLitePromo = appPath('/login?plan=line_lite&campaign=lstep500');
const loginLinePro = appPath('/login?plan=line_pro');
---

<div class="line-cost-simulator space-y-6 p-5 md:p-6">
  <p class="text-sm leading-relaxed text-neutral-600">
    LINEの配信料金は、これまで通り各店舗へ請求されます。変わるのは管理ツールの月額だけです。
    今お使いのLステップのプランと、月の配信通数を入れると、BuzzItに替えた場合の節約額がその場でわかります。
  </p>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <div class="space-y-5">
      <label class="block">
        <span class="mb-2 block text-xs font-semibold uppercase tracking-wider text-neutral-500">
          月間配信通数
        </span>
        <input
          id="sim-messages"
          type="range"
          min="1000"
          max="50000"
          step="500"
          value="10000"
          class="w-full accent-neutral-900"
        />
        <div class="mt-3 flex items-center gap-3">
          <input
            id="sim-messages-input"
            type="number"
            min="0"
            step="500"
            value="10000"
            class="w-full border border-neutral-300 bg-white px-3 py-2 text-sm"
          />
          <span class="shrink-0 text-sm text-neutral-500">通 / 月</span>
        </div>
      </label>

      <div>
        <span class="mb-2 block text-xs font-semibold uppercase tracking-wider text-neutral-500">
          今お使いの Lステップ プラン
        </span>
        <div class="flex flex-wrap gap-2">
          <button type="button" data-lstep="start" class="sim-lstep-btn border border-neutral-200 bg-white px-3 py-2 text-xs hover:border-neutral-400">スタート ¥5,000</button>
          <button type="button" data-lstep="standard" class="sim-lstep-btn border border-neutral-900 bg-neutral-900 px-3 py-2 text-xs text-white">スタンダード ¥21,780</button>
          <button type="button" data-lstep="pro" class="sim-lstep-btn border border-neutral-200 bg-white px-3 py-2 text-xs hover:border-neutral-400">プロ ¥32,780</button>
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        {MESSAGE_PRESETS.map((preset) => (
          <button
            type="button"
            data-preset={preset}
            class="sim-preset border border-neutral-200 bg-white px-3 py-1.5 text-xs hover:border-neutral-400"
          >
            {preset.toLocaleString('ja-JP')}通
          </button>
        ))}
      </div>
    </div>

    <div class="space-y-4">
      <div class="border border-neutral-200 bg-white p-4">
        <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500">LINE公式（どちらも同じ）</p>
        <p id="sim-line-plan" class="mt-1 text-sm font-medium text-neutral-900">—</p>
        <ul id="sim-line-breakdown" class="mt-2 space-y-1 text-sm text-neutral-600"></ul>
        <p id="sim-line-total" class="mt-2 text-base font-bold text-neutral-900">—</p>
      </div>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div class="border border-neutral-200 bg-white p-4">
          <p class="text-xs text-neutral-500">Lステップ利用時</p>
          <p id="sim-lstep-total" class="buzz-stat-value mt-1 text-xl">—</p>
          <p id="sim-lstep-crm" class="mt-1 text-xs text-neutral-500">管理ツール —</p>
        </div>
        <div class="border border-neutral-900 bg-neutral-900 p-4 text-white">
          <p class="text-xs text-neutral-300">BuzzIt LINE管理プロ</p>
          <p id="sim-buzzit-total" class="buzz-stat-value buzz-stat-value--light mt-1 text-xl">—</p>
          <p id="sim-buzzit-crm" class="mt-1 text-xs text-neutral-400">管理ツール ¥4,980</p>
        </div>
      </div>

      <div class="border border-green-200 bg-green-50 p-4">
        <p class="text-xs font-semibold uppercase tracking-wider text-green-800">BuzzItに替えた場合の節約</p>
        <p id="sim-savings" class="mt-1 text-2xl font-bold text-green-800">—</p>
        <p id="sim-savings-annual" class="mt-1 text-sm text-green-700">—</p>
        <p id="sim-segment" class="mt-2 text-xs text-green-700">—</p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 border-t border-neutral-200 pt-6 md:grid-cols-2">
    <div class="border border-neutral-900 bg-neutral-900 p-5 text-white">
      <p class="text-[10px] font-bold uppercase tracking-widest text-neutral-400">乗り換えキャンペーン</p>
      <h4 class="mt-2 font-display text-lg font-bold">LINE管理ライト — 初回3ヶ月 ¥500/月</h4>
      <p class="mt-2 text-sm text-neutral-300">
        4ヶ月目以降 ¥980/月。一斉配信・タグ付け・登録経路（友だち500人まで）。
      </p>
      <p id="sim-promo-total" class="buzz-stat-value buzz-stat-value--light mt-3 text-xl">—</p>
      <a
        href={loginLitePromo}
        class="mt-4 block bg-white py-3 text-center text-sm font-bold text-neutral-900 hover:bg-neutral-100"
      >
        3ヶ月 ¥500 で始める
      </a>
    </div>
    <div class="border border-neutral-200 bg-white p-5">
      <p class="text-[10px] font-bold uppercase tracking-widest text-neutral-500">本格的なLINE運用</p>
      <h4 class="mt-2 font-display text-lg font-bold text-neutral-900">LINE管理プロ ¥4,980/月</h4>
      <p class="mt-2 text-sm text-neutral-600">
        絞り込み配信・あいさつメッセージ・画面下メニュー・配信コスト試算。
      </p>
      <a
        href={loginLinePro}
        class="mt-6 block border border-neutral-900 py-3 text-center text-sm font-bold text-neutral-900 hover:bg-neutral-50"
      >
        LINE管理プロを試す
      </a>
    </div>
  </div>
</div>

<script>
  const LINE_LIGHT_INCLUDED = 5000;
  const LINE_LIGHT_BASE = 5000;
  const LINE_STANDARD_BASE = 16500;
  const LINE_PRICE_PER_MSG = 3;
  const LSTEP_FEES: Record<string, number> = { start: 5000, standard: 21780, pro: 32780 };
  const LINE_CRM_PRO = 4980;
  const LINE_CRM_LITE_PROMO = 500;

  function calcLine(monthlyMessages: number) {
    const messageCount = Math.max(0, Math.round(monthlyMessages));
    if (messageCount <= LINE_LIGHT_INCLUDED) {
      return {
        planLabel: 'ライト（月5,000通まで）',
        baseFee: LINE_LIGHT_BASE,
        overageMessages: 0,
        messageFee: 0,
        lineTotal: LINE_LIGHT_BASE,
      };
    }
    const overageMessages = messageCount - LINE_LIGHT_INCLUDED;
    const messageFee = Math.round(overageMessages * LINE_PRICE_PER_MSG);
    return {
      planLabel: 'スタンダード（5,000通超）',
      baseFee: LINE_STANDARD_BASE,
      overageMessages,
      messageFee,
      lineTotal: LINE_STANDARD_BASE + messageFee,
    };
  }

  function yen(n: number) {
    return `¥${n.toLocaleString('ja-JP')}`;
  }

  let messages = 10000;
  let lstepPlan = 'standard';

  const els = {
    messages: document.getElementById('sim-messages') as HTMLInputElement,
    messagesInput: document.getElementById('sim-messages-input') as HTMLInputElement,
    linePlan: document.getElementById('sim-line-plan'),
    lineBreakdown: document.getElementById('sim-line-breakdown'),
    lineTotal: document.getElementById('sim-line-total'),
    lstepTotal: document.getElementById('sim-lstep-total'),
    lstepCrm: document.getElementById('sim-lstep-crm'),
    buzzitTotal: document.getElementById('sim-buzzit-total'),
    savings: document.getElementById('sim-savings'),
    savingsAnnual: document.getElementById('sim-savings-annual'),
    segment: document.getElementById('sim-segment'),
    promoTotal: document.getElementById('sim-promo-total'),
  };

  function render() {
    const line = calcLine(messages);
    const lstepCrm = LSTEP_FEES[lstepPlan] ?? 0;
    const lstepTotal = line.lineTotal + lstepCrm;
    const buzzitTotal = line.lineTotal + LINE_CRM_PRO;
    const promoTotal = line.lineTotal + LINE_CRM_LITE_PROMO;
    const savings = lstepTotal - buzzitTotal;
    const segmentMessages = Math.round(messages * 0.4);
    const segmentTotal = calcLine(segmentMessages).lineTotal + LINE_CRM_PRO;

    if (els.linePlan) els.linePlan.textContent = line.planLabel;
    if (els.lineBreakdown) {
      els.lineBreakdown.innerHTML = [
        `<li>基本料 ${yen(line.baseFee)}</li>`,
        line.overageMessages > 0
          ? `<li>追加配信 ${line.overageMessages.toLocaleString('ja-JP')}通 × ¥3 = ${yen(line.messageFee)}</li>`
          : '<li>追加配信 なし（ライト枠内）</li>',
      ].join('');
    }
    if (els.lineTotal) els.lineTotal.textContent = `LINE公式 合計 ${yen(line.lineTotal)} / 月`;
    if (els.lstepTotal) els.lstepTotal.textContent = yen(lstepTotal);
    if (els.lstepCrm) els.lstepCrm.textContent = `管理ツール ${yen(lstepCrm)} + LINE ${yen(line.lineTotal)}`;
    if (els.buzzitTotal) els.buzzitTotal.textContent = yen(buzzitTotal);
    if (els.savings) els.savings.textContent = `月 ${yen(Math.max(0, savings))} お得`;
    if (els.savingsAnnual) els.savingsAnnual.textContent = `年間 ${yen(Math.max(0, savings) * 12)} の節約（管理ツールの差額）`;
    if (els.segment) {
      els.segment.textContent = `必要な人だけ配信（${segmentMessages.toLocaleString('ja-JP')}通）なら BuzzIt 合計 ${yen(segmentTotal)} / 月`;
    }
    if (els.promoTotal) els.promoTotal.textContent = `キャンペーン中の合計 ${yen(promoTotal)} / 月`;
  }

  function setMessages(v: number) {
    messages = Math.max(0, Math.min(50000, v));
    if (els.messages) els.messages.value = String(messages);
    if (els.messagesInput) els.messagesInput.value = String(messages);
    render();
  }

  els.messages?.addEventListener('input', () => setMessages(Number(els.messages.value)));
  els.messagesInput?.addEventListener('input', () => setMessages(Number(els.messagesInput.value)));

  document.querySelectorAll('.sim-lstep-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      lstepPlan = (btn as HTMLButtonElement).dataset.lstep ?? 'standard';
      document.querySelectorAll('.sim-lstep-btn').forEach((b) => {
        b.classList.remove('border-neutral-900', 'bg-neutral-900', 'text-white');
        b.classList.add('border-neutral-200', 'bg-white');
      });
      btn.classList.add('border-neutral-900', 'bg-neutral-900', 'text-white');
      btn.classList.remove('border-neutral-200', 'bg-white');
      render();
    });
  });

  document.querySelectorAll('.sim-preset').forEach((btn) => {
    btn.addEventListener('click', () => setMessages(Number((btn as HTMLButtonElement).dataset.preset)));
  });

  render();
</script>
