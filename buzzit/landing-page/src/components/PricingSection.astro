---
import { appPath } from '../lib/urls';

const loginUrl = appPath('/login');

const plans = [
  {
    name: 'Starter',
    price: '¥0',
    period: '',
    features: ['AI台本生成', 'SNS健康診断', 'Powered by BuzzIt 透かし'],
    cta: '無料で始める',
    highlight: false,
  },
  {
    name: 'Pro',
    price: '¥4,980',
    period: '/月',
    features: ['全SNS自動予約', 'AI処方的提案', '透かし削除'],
    cta: 'Proを試す',
    highlight: false,
  },
  {
    name: 'Team',
    price: '¥9,800',
    period: '/月',
    features: ['Slack連携（ネタ会議）', '戦略的通知（朝/昼/夜）', 'チーム承認フロー'],
    cta: 'Teamを試す',
    highlight: true,
    badge: 'おすすめ',
  },
  {
    name: 'Growth OS',
    price: '¥29,800',
    period: '/月',
    features: ['深い売上トラッキング', 'Auto Mode（完全自動）', 'アンバサダーCRM'],
    cta: '相談する',
    highlight: false,
  },
];
---

<section id="pricing" class="bg-[#faf9fc] py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="animate-on-scroll slide-up mb-14 text-center">
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-violet-600">Pricing</p>
      <h2 class="font-display text-3xl font-bold text-[#0c0a12] md:text-5xl">シンプルな料金プラン</h2>
      <p class="mt-4 text-base text-slate-500">無料から始めて、組織化・経営OSへ段階的にスケール。</p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {plans.map((plan, i) => (
        <article
          class={`animate-on-scroll slide-up relative flex flex-col rounded-3xl p-7 transition-all hover:-translate-y-1 ${
            plan.highlight
              ? 'bg-[#0c0a12] text-white shadow-2xl shadow-violet-500/20 ring-1 ring-violet-500/30'
              : 'border border-slate-200 bg-white hover:shadow-lg'
          } ${i === 1 ? 'delay-100' : i === 2 ? 'delay-200' : i === 3 ? 'delay-300' : ''}`}
        >
          {plan.badge && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-gradient-to-r from-violet-500 to-rose-500 px-3 py-1 text-[10px] font-bold text-white">
              {plan.badge}
            </span>
          )}
          <h3 class={`font-display text-lg font-bold ${plan.highlight ? 'text-white' : 'text-[#0c0a12]'}`}>{plan.name}</h3>
          <p class={`mt-2 font-display text-3xl font-bold ${plan.highlight ? 'text-white' : 'text-violet-600'}`}>
            {plan.price}
            {plan.period && <span class={`text-sm font-normal ${plan.highlight ? 'text-white/50' : 'text-slate-400'}`}>{plan.period}</span>}
          </p>
          <ul class={`mt-6 flex-1 space-y-2.5 text-sm ${plan.highlight ? 'text-white/65' : 'text-slate-500'}`}>
            {plan.features.map((f) => (
              <li class="flex items-start gap-2">
                <span class={`mt-1.5 h-1 w-1 shrink-0 rounded-full ${plan.highlight ? 'bg-violet-400' : 'bg-violet-500'}`}></span>
                {f}
              </li>
            ))}
          </ul>
          <a
            href={loginUrl}
            class={`mt-8 block rounded-full py-3 text-center text-sm font-bold transition-all ${
              plan.highlight
                ? 'bg-white text-[#0c0a12] hover:bg-violet-100'
                : 'border border-slate-200 text-[#0c0a12] hover:border-violet-300 hover:bg-violet-50'
            }`}
          >
            {plan.cta}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
