---
import { appPath } from '../lib/urls';

const loginUrl = appPath('/login');

const plans = [
  {
    name: 'Starter',
    price: '¥0',
    period: '',
    features: ['AI台本生成', 'SNS健康診断', 'Powered by BuzzIt 透かし'],
    cta: '無料で始める',
    highlight: false,
  },
  {
    name: 'Pro',
    price: '¥4,980',
    period: '/月',
    features: ['全SNS自動予約', 'AI処方的提案', '透かし削除'],
    cta: 'Proを試す',
    highlight: false,
  },
  {
    name: 'Team',
    price: '¥9,800',
    period: '/月',
    features: ['Slack連携（ネタ会議）', '戦略的通知（朝/昼/夜）', 'チーム承認フロー'],
    cta: 'Teamを試す',
    highlight: true,
    badge: 'おすすめ',
  },
  {
    name: 'Growth OS',
    price: '¥29,800',
    period: '/月',
    features: ['深い売上トラッキング', 'Auto Mode（完全自動）', 'アンバサダーCRM'],
    cta: '相談する',
    highlight: false,
  },
];
---

<section id="pricing" class="bg-white py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="animate-on-scroll slide-up mb-14">
      <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-neutral-500">Pricing</p>
      <h2 class="font-display text-3xl font-bold text-neutral-900 md:text-4xl lg:text-5xl">シンプルな料金プラン</h2>
      <p class="mt-4 text-base text-neutral-600">無料から始めて、組織化・経営OSへ段階的にスケール。</p>
    </div>

    <div class="grid grid-cols-1 gap-px overflow-hidden border border-neutral-200 bg-neutral-200 sm:grid-cols-2 lg:grid-cols-4">
      {plans.map((plan, i) => (
        <article
          class={`animate-on-scroll slide-up relative flex flex-col bg-white p-7 ${i === 1 ? 'delay-100' : i === 2 ? 'delay-200' : i === 3 ? 'delay-300' : ''} ${plan.highlight ? 'bg-neutral-900 text-white' : ''}`}
        >
          {plan.badge && (
            <span class="absolute -top-px left-0 bg-neutral-900 px-3 py-1 text-[10px] font-bold text-white">
              {plan.badge}
            </span>
          )}
          <h3 class={`font-display text-lg font-bold ${plan.highlight ? 'text-white' : 'text-neutral-900'}`}>{plan.name}</h3>
          <p class:list={['buzz-stat-value mt-2 text-3xl', plan.highlight && 'buzz-stat-value--light']}>
            {plan.price}
            {plan.period && <span class={`text-sm font-normal ${plan.highlight ? 'text-neutral-400' : 'text-neutral-500'}`}>{plan.period}</span>}
          </p>
          <ul class={`mt-6 flex-1 space-y-2.5 text-sm ${plan.highlight ? 'text-neutral-300' : 'text-neutral-600'}`}>
            {plan.features.map((f) => (
              <li class="flex items-start gap-2">
                <span class={`mt-2 h-1 w-1 shrink-0 rounded-full ${plan.highlight ? 'bg-white' : 'bg-neutral-900'}`}></span>
                {f}
              </li>
            ))}
          </ul>
          <a
            href={loginUrl}
            class={`mt-8 block py-3 text-center text-sm font-bold transition-colors ${
              plan.highlight
                ? 'bg-white text-neutral-900 hover:bg-neutral-100'
                : 'border border-neutral-300 text-neutral-900 hover:border-neutral-900'
            }`}
          >
            {plan.cta}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
