---
import { appPath } from '../lib/urls';
import { images } from '../lib/images';

const loginUrl = appPath('/login');
---

<section class="relative overflow-hidden border-y border-slate-100 bg-[#faf9fc] py-24 md:py-32">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 md:grid-cols-2 md:gap-16 md:px-8">
    <div class="animate-on-scroll slide-right order-2 md:order-1">
      <div class="relative">
        <div class="overflow-hidden rounded-3xl shadow-2xl shadow-violet-500/10">
          <img
            src={images.cafeStore}
            alt="店舗の雰囲気"
            class="aspect-[4/3] w-full object-cover transition-transform duration-700 hover:scale-[1.02]"
            loading="lazy"
          />
        </div>
        <div class="absolute -bottom-6 -right-4 w-[72%] max-w-sm rounded-2xl border border-white/80 bg-white/95 p-5 shadow-xl backdrop-blur md:-right-8">
          <div class="mb-3 flex items-center gap-2">
            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-purple-500 via-pink-500 to-orange-400 text-xs font-bold text-white">IG</span>
            <div>
              <p class="text-sm font-bold text-slate-900">今日のミッション</p>
              <p class="text-xs text-slate-400">春カラー Reels</p>
            </div>
          </div>
          <p class="rounded-xl bg-slate-50 p-3 text-xs leading-relaxed text-slate-600">
            【悲報】春カラー、予約が埋まりすぎて… 詳細はプロフィールのLINEから▼
          </p>
          <div class="mt-3 grid grid-cols-3 gap-2 text-center">
            <div class="rounded-lg bg-violet-50 py-2">
              <p class="text-sm font-bold text-violet-600">24.5K</p>
              <p class="text-[10px] text-slate-400">リーチ</p>
            </div>
            <div class="rounded-lg bg-sky-50 py-2">
              <p class="text-sm font-bold text-sky-600">124</p>
              <p class="text-[10px] text-slate-400">LINE</p>
            </div>
            <div class="rounded-lg bg-emerald-50 py-2">
              <p class="text-sm font-bold text-emerald-600">¥342K</p>
              <p class="text-[10px] text-slate-400">売上</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="animate-on-scroll slide-left order-1 md:order-2">
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-violet-600">Instagram × LINE</p>
      <h2 class="font-display text-3xl font-bold text-[#0c0a12] md:text-4xl">
        Instagram で集客、<br />LINE でリピート。
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate-500 md:text-lg">
        「いいね数」ではなく、LINE友だち追加・来店・売上をKPIに設計。店舗ビジネスで最も効く導線を、毎朝5分のルーティンで回せます。
      </p>
      <ul class="mt-8 space-y-4">
        {[
          'Reels・ストーリーズ向けの台本をAIが自動生成',
          'プロフィールリンク→LINE登録の導線をテンプレ化',
          '投稿→LINE→来店までをダッシュボードで可視化',
        ].map((text, i) => (
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#0c0a12] text-[11px] font-bold text-white">{i + 1}</span>
            <span class="text-sm text-slate-700 md:text-base">{text}</span>
          </li>
        ))}
      </ul>
      <a
        href={loginUrl}
        class="mt-9 inline-flex rounded-full bg-[#0c0a12] px-8 py-3.5 text-sm font-bold text-white transition-all hover:bg-violet-700"
      >
        無料診断を始める
      </a>
    </div>
  </div>
</section>
