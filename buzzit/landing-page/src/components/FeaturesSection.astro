---
import { images } from '../lib/images';

const integrations = [
  { name: 'Instagram', subtitle: 'リール・投稿・ストーリーズ' },
  { name: 'Facebook', subtitle: 'ページへの自動投稿' },
  { name: 'Threads', subtitle: 'Instagram系列' },
  { name: 'LINE 公式', subtitle: 'メッセージ配信' },
  { name: 'Googleマップ', subtitle: '店舗情報の同時更新' },
  { name: 'ホットペッパー', subtitle: '予約の効果測定' },
  { name: 'Slack', subtitle: '社内チャット連携' },
  { name: 'X', subtitle: '近日対応' },
];
---

<section id="features" class="bg-[#f5f4f0] py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="animate-on-scroll slide-up mb-14 md:mb-16 headline-fit-wrap">
      <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-neutral-500">機能</p>
      <h2 class="font-display text-3xl font-bold md:text-4xl lg:text-5xl" data-headline-fit>
        店舗運用に必要な機能を、すべて内包。
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-neutral-600">
        SNS、LINE、Googleマップ、ホットペッパー。バラバラだったツールをBuzzIt一本に。現場の代わりに、自律的に回します。
      </p>
    </div>

    <div class="grid grid-cols-1 gap-3 md:grid-cols-2 md:gap-4">
      <article class="animate-on-scroll slide-up flex flex-col border border-neutral-200 bg-white p-8">
        <p class="mb-4 text-[10px] font-bold uppercase tracking-wider text-neutral-400">AI・音声入力</p>
        <h3 class="font-display text-xl font-bold text-neutral-900 md:text-2xl">AI台本とボイスドラフト</h3>
        <p class="mt-3 flex-1 text-sm leading-relaxed text-neutral-600">
          毎朝「今日の台本」をAIが提案。施術中の会話を録音して送るだけで、Instagram・LINE用の文章を一度に作成できます。
        </p>
      </article>

      <article class="animate-on-scroll slide-up delay-100 group relative min-h-[320px] overflow-hidden">
        <img
          src={images.teamWork}
          alt="チームでSNS運用"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-neutral-900/55"></div>
        <div class="relative flex h-full flex-col justify-end p-8">
          <p class="mb-2 text-[10px] font-bold uppercase tracking-wider text-neutral-300">自動化</p>
          <h3 class="font-display text-xl font-bold text-white md:text-2xl">全SNSへの一気通貫投稿</h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-200">
            1本の動画から、Instagram・LINE・Googleマップ・ホットペッパー向けにそれぞれ最適化。Slackでスタッフのネタも集められます。
          </p>
        </div>
      </article>

      <article class="animate-on-scroll slide-up delay-100 flex flex-col border border-neutral-200 bg-white p-8">
        <p class="mb-4 text-[10px] font-bold uppercase tracking-wider text-neutral-400">LINE管理</p>
        <h3 class="font-display text-xl font-bold text-neutral-900 md:text-2xl">Lステップ代替のLINE CRM</h3>
        <p class="mt-3 text-sm leading-relaxed text-neutral-600">
          タグ付け・登録経路・絞り込み配信・あいさつメッセージ・画面下メニューまで、BuzzItだけで完結。
        </p>
        <ul class="mt-4 space-y-2 border-t border-neutral-200 pt-4 text-xs leading-relaxed text-neutral-600">
          <li><span class="font-semibold text-neutral-800">タグ付け</span> — 来店回数・興味など</li>
          <li><span class="font-semibold text-neutral-800">登録経路</span> — QR・広告ごとに計測</li>
          <li><span class="font-semibold text-neutral-800">絞り込み配信</span> — 必要な人にだけ送る</li>
        </ul>
        <a href="#line-cost" class="mt-4 text-xs font-semibold text-neutral-900 underline underline-offset-2">
          LINE料金の比較を見る →
        </a>
      </article>

      <article class="animate-on-scroll slide-up delay-200 group relative min-h-[320px] overflow-hidden">
        <img
          src={images.salonInterior}
          alt="サロン店内"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-neutral-900/55"></div>
        <div class="relative flex h-full flex-col justify-end p-8">
          <p class="mb-2 text-[10px] font-bold uppercase tracking-wider text-neutral-300">売上</p>
          <h3 class="font-display text-xl font-bold text-white md:text-2xl">予約・売上の見える化</h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-200">
            どの投稿がホットペッパービューティーの予約につながったかがわかります。Googleマップの投稿・口コミ返信・検索レポートにも対応。
          </p>
        </div>
      </article>
    </div>

    <div class="animate-on-scroll slide-up delay-300 mt-16">
      <p class="mb-5 text-center text-[10px] font-bold uppercase tracking-widest text-neutral-500">連携できるサービス</p>
      <div class="grid grid-cols-2 gap-px overflow-hidden border border-neutral-200 bg-neutral-200 sm:grid-cols-4">
        {integrations.map((item) => (
          <div class="flex flex-col items-center justify-center bg-white p-5 text-center">
            <p class="font-display text-sm font-bold text-neutral-900">{item.name}</p>
            <p class="mt-1 text-xs text-neutral-500">{item.subtitle}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
