---
const funnelRows = [
  { label: 'リーチ', value: '24,500', width: '100%', accent: false },
  { label: 'LINE登録', value: '124', width: '30%', accent: false },
  { label: '推計売上', value: '¥34.2万', width: '15%', accent: true },
];
---

<section id="cockpit" class="bg-[#f5f4f0] py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="animate-on-scroll slide-up mb-12 md:mb-14 headline-fit-wrap">
      <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-neutral-500">管理画面</p>
      <h2 class="font-display text-3xl font-bold md:text-4xl lg:text-5xl" data-headline-fit>
        今日やること、ひと目でわかる
      </h2>
      <p class="mt-4 text-base text-neutral-600">複雑なグラフは不要。今日やるべきことは、AIがすべて提案します。</p>
    </div>

    <div class="animate-on-scroll slide-up delay-100 overflow-hidden border border-neutral-200 bg-white">
      <div class="flex h-11 items-center gap-2 border-b border-neutral-200 bg-neutral-50 px-5">
        <span class="h-2.5 w-2.5 rounded-full bg-neutral-300"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-neutral-300"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-neutral-300"></span>
        <span class="ml-4 text-xs text-neutral-400">app.buzzit.shigotoku.com</span>
      </div>
      <div class="grid grid-cols-1 gap-6 p-6 md:grid-cols-3 md:p-8">
        <div class="md:col-span-2 space-y-5">
          <div class="border border-neutral-200 bg-neutral-50 p-6 md:p-8">
            <p class="mb-3 text-[10px] font-bold uppercase tracking-widest text-neutral-500">今日のお仕事</p>
            <h3 class="font-display text-xl font-bold text-neutral-900 md:text-2xl">新作「春カラー」の動画を承認してください</h3>
            <p class="mt-2 text-sm text-neutral-600 md:text-base">AIが3パターンの台本を生成。確認後、ワンタップで全SNSへ予約されます。</p>
            <button class="mt-5 bg-neutral-900 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-neutral-700">
              内容を確認・承認する
            </button>
          </div>
          <div class="border border-neutral-200 p-6">
            <p class="text-sm text-neutral-500">SNS健康スコア</p>
            <p class="buzz-stat-value text-5xl">
              92
              <span class="ml-2 text-lg font-semibold text-neutral-600">+12%</span>
            </p>
          </div>
        </div>
        <div class="border border-neutral-200 p-6">
          <h3 class="font-display text-lg font-bold text-neutral-900">来店までの流れ</h3>
          <div class="mt-6 space-y-5">
            {funnelRows.map((row) => (
              <div>
                <div class="mb-1.5 flex justify-between text-sm">
                  <span class="text-neutral-500">{row.label}</span>
                  <span class="buzz-stat-value text-sm">{row.value}</span>
                </div>
                <div class="h-1.5 overflow-hidden bg-neutral-100">
                  <div class="h-full bg-neutral-900" style={`width: ${row.width}`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
