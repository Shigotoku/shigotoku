---
import { appPath } from '../lib/urls';

const loginUrl = appPath('/login');
---

<header class="fixed top-0 z-50 w-full border-b border-neutral-200/80 bg-[#f5f4f0]/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 md:px-8">
    <a href="#top" class="flex items-center gap-2.5">
      <span class="flex h-8 w-8 items-center justify-center bg-neutral-900 text-xs font-bold text-white">B</span>
      <span class="font-display text-lg font-bold tracking-tight text-neutral-900">BuzzIt</span>
    </a>
    <nav class="hidden items-center gap-8 text-sm font-medium text-neutral-600 md:flex">
      <a href="#transform" class="transition-colors hover:text-neutral-900">変化</a>
      <a href="#features" class="transition-colors hover:text-neutral-900">機能</a>
      <a href="#pricing" class="transition-colors hover:text-neutral-900">料金</a>
    </nav>
    <div class="flex items-center gap-3">
      <a href={loginUrl} class="hidden text-sm font-medium text-neutral-600 transition-colors hover:text-neutral-900 sm:block">ログイン</a>
      <a
        href={loginUrl}
        class="rounded-sm bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-neutral-700"
      >
        無料で始める
      </a>
    </div>
  </div>
</header>
