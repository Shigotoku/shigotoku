---
import { appPath } from '../lib/urls';
import { images } from '../lib/images';

const loginUrl = appPath('/login');

const stats = [
  { value: '90%', label: '運用時間削減' },
  { value: '3.2×', label: 'リーチ改善' },
  { value: '+¥34.2万', label: '推計売上 / 月' },
];
---

<section id="top" class="buzz-hero relative overflow-hidden pt-20 pb-14 md:pt-24 md:pb-24">
  <div class="buzz-hero-bg" aria-hidden="true">
    <img
      src={images.heroCollage}
      alt=""
      width="2400"
      height="1600"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="buzz-hero-scrim" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-5 pt-6 md:px-8 md:pt-10">
    <div class="buzz-hero-panel max-w-xl pb-16 pt-10 md:pb-24 md:pt-12 lg:max-w-2xl headline-fit-wrap">
      <p class="animate-on-scroll slide-up text-[11px] font-semibold uppercase tracking-[0.22em] text-neutral-600">
        BtoC店舗のための SNS 経営OS
      </p>
      <h1 class="animate-on-scroll slide-up delay-100 mt-5 font-display text-[2.25rem] font-bold leading-[1.12] md:text-5xl lg:text-[3.25rem]">
        <span data-headline-fit data-headline-max="36">SNSを伸ばす。</span>
        <span data-headline-fit data-headline-max="36">売上をつくる。</span>
      </h1>
      <p class="animate-on-scroll slide-up delay-200 mt-6 max-w-md text-base leading-[1.85] text-neutral-700 md:text-[17px]">
        毎朝5分。AIが今日の台本と投稿スケジュールを用意し、チーム承認から全SNS配信まで一気通貫。美容・クリニック・飲食店の現場向けに設計されています。
      </p>
      <div class="animate-on-scroll slide-up delay-300 mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href={loginUrl}
          class="inline-flex items-center justify-center bg-neutral-900 px-8 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-neutral-700"
        >
          無料診断を始める
        </a>
        <a
          href="#features"
          class="inline-flex items-center justify-center border border-neutral-400/80 bg-white/90 px-8 py-3.5 text-sm font-semibold text-neutral-800 backdrop-blur-sm transition-colors hover:border-neutral-900"
        >
          機能を見る
        </a>
      </div>

      <div class="animate-on-scroll slide-up delay-300 mt-12 border-t border-neutral-400/50 pt-8">
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3 sm:gap-4 md:gap-6">
          {stats.map((stat, i) => (
            <div class:list={[i < 2 && 'sm:border-r sm:border-neutral-400/50 sm:pr-4 md:pr-6']}>
              <p class="buzz-stat-value text-2xl sm:text-3xl md:text-4xl">{stat.value}</p>
              <p class="buzz-stat-label">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
