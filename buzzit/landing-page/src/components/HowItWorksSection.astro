---
import { appPath } from '../lib/urls';
import { images } from '../lib/images';

const loginUrl = appPath('/login');

const steps = [
  {
    time: '朝',
    title: 'AIが今日の台本を提案',
    description: '施術中の会話を音声入力してもOK。確認して承認するだけで、投稿の準備が完了します。',
  },
  {
    time: '昼',
    title: '全チャネルに自動投稿',
    description: 'Instagram・LINE・Googleマップへ、それぞれ最適な内容をワンタップで予約投稿。',
  },
  {
    time: '夜',
    title: '売上までひと目で確認',
    description: 'リーチ→LINE登録→来店→売上の流れをダッシュボードで把握。いいね数ではなく、来店と売上で判断できます。',
  },
];

const funnelRows = [
  { label: 'リーチ', value: '24,500', width: '100%' },
  { label: 'LINE登録', value: '124', width: '30%' },
  { label: '推計売上', value: '¥34.2万', width: '15%' },
];

const flowPoints = [
  'リール・ストーリーズ向けの台本をAIが自動生成',
  'プロフィールリンク→LINE登録の導線をテンプレ化',
  '投稿→LINE→来店までをダッシュボードで可視化',
];
---

<section id="how-it-works" class="bg-white py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="animate-on-scroll slide-up mb-14 md:mb-16 headline-fit-wrap">
      <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-neutral-500">使い方</p>
      <h2 class="font-display text-3xl font-bold md:text-4xl lg:text-5xl" data-headline-fit>
        毎朝5分。1日の流れがこれだけ。
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-neutral-600">
        複雑な運用はBuzzItに任せて、あなたは本業に集中するだけ。朝・昼・夜の3ステップで、SNSから売上まで回ります。
      </p>
    </div>

    <div class="animate-on-scroll slide-up mb-12 grid grid-cols-1 gap-4 md:grid-cols-3">
      {steps.map((step, index) => (
        <article class={`border border-neutral-200 bg-[#f5f4f0] p-6 ${index === 1 ? 'delay-100' : index === 2 ? 'delay-200' : ''}`}>
          <p class="text-[10px] font-bold uppercase tracking-widest text-neutral-500">{step.time}</p>
          <h3 class="mt-2 font-display text-lg font-bold text-neutral-900 md:text-xl">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-600">{step.description}</p>
        </article>
      ))}
    </div>

    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="animate-on-scroll slide-up delay-100 overflow-hidden border border-neutral-200 bg-white">
        <div class="flex h-11 items-center gap-2 border-b border-neutral-200 bg-neutral-50 px-5">
          <span class="h-2.5 w-2.5 rounded-full bg-neutral-300"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-neutral-300"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-neutral-300"></span>
          <span class="ml-4 text-xs text-neutral-400">app.buzzit.shigotoku.com</span>
        </div>
        <div class="space-y-5 p-6 md:p-8">
          <div class="border border-neutral-200 bg-neutral-50 p-6">
            <p class="mb-3 text-[10px] font-bold uppercase tracking-widest text-neutral-500">今日のお仕事</p>
            <h3 class="font-display text-xl font-bold text-neutral-900">新作「春カラー」の動画を承認してください</h3>
            <p class="mt-2 text-sm text-neutral-600">AIが3パターンの台本を生成。確認後、ワンタップで全SNSへ予約されます。</p>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="border border-neutral-200 p-4">
              <p class="text-xs text-neutral-500">SNS健康スコア</p>
              <p class="buzz-stat-value mt-1 text-3xl">
                92
                <span class="ml-1 text-sm font-semibold text-neutral-600">+12%</span>
              </p>
            </div>
            <div class="border border-neutral-200 p-4">
              <p class="text-xs text-neutral-500">来店までの流れ</p>
              <div class="mt-3 space-y-3">
                {funnelRows.map((row) => (
                  <div>
                    <div class="mb-1 flex justify-between text-xs">
                      <span class="text-neutral-500">{row.label}</span>
                      <span class="buzz-stat-value">{row.value}</span>
                    </div>
                    <div class="h-1 overflow-hidden bg-neutral-100">
                      <div class="h-full bg-neutral-900" style={`width: ${row.width}`}></div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="animate-on-scroll slide-up delay-200">
        <div class="relative mb-8 overflow-hidden">
          <img
            src={images.cafeStore}
            alt="店舗の雰囲気"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
          />
          <div class="absolute bottom-4 right-4 w-[88%] max-w-xs border border-neutral-200 bg-white p-4 shadow-lg">
            <div class="mb-2 flex items-center gap-2">
              <span class="flex h-8 w-8 items-center justify-center bg-neutral-900 text-[10px] font-bold text-white">IG</span>
              <div>
                <p class="text-xs font-semibold text-neutral-900">今日のミッション</p>
                <p class="text-[10px] text-neutral-500">春カラー リール</p>
              </div>
            </div>
            <p class="bg-neutral-50 p-2 text-[11px] leading-relaxed text-neutral-600">
              【悲報】春カラー、予約が埋まりすぎて… 詳細はプロフィールのLINEから▼
            </p>
          </div>
        </div>

        <p class="mb-3 text-[11px] font-semibold tracking-[0.18em] text-neutral-500">
          <span class="buzz-latin">Instagram</span> × <span class="buzz-latin">LINE</span>
        </p>
        <h3 class="font-display text-2xl font-bold text-neutral-900 md:text-3xl">
          Instagramで集客、LINEでリピート。
        </h3>
        <p class="mt-3 text-base leading-relaxed text-neutral-600">
          「いいね数」ではなく、LINE友だち追加・来店・売上を見える化。店舗に効く流れを、毎朝5分のルーティンで回せます。
        </p>
        <ul class="mt-6 space-y-3">
          {flowPoints.map((text, i) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center bg-neutral-900 text-[11px] font-bold text-white">{i + 1}</span>
              <span class="text-sm text-neutral-700">{text}</span>
            </li>
          ))}
        </ul>
        <a
          href={loginUrl}
          class="mt-8 inline-flex bg-neutral-900 px-8 py-3.5 text-sm font-bold text-white transition-colors hover:bg-neutral-700"
        >
          無料で始める
        </a>
      </div>
    </div>
  </div>
</section>
